---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>404 | Inessentia</title>
  <!-- Fuentes auto-hospedadas vía @font-face en global.css -->
</head>
<body style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:32px;">
  <div style="max-width:520px;text-align:left;">
    <div style="font-size:120px;line-height:1;margin-bottom:16px;opacity:.15;font-family:var(--ff-head);font-weight:700;color:var(--heading);">404</div>
    <h1 style="font-family:var(--ff-head);font-weight:700;color:var(--heading);font-size:clamp(26px,4vw,38px);line-height:var(--lh-tight);margin:0 0 18px;">Oops, parece que nos disociamos de algo por aquí.</h1>
    <p style="font-size:17px;line-height:1.65;color:var(--text-soft);margin:0 0 32px;">La página que buscas no existe, se mudó, o simplemente necesita un momento a solas.</p>
    <a href="/es/" class="btn btn--primary">Volver a casa</a>
  </div>

  <script is:inline>
    // Detecta idioma: primero preferencia guardada, luego el del navegador
    var saved = localStorage.getItem('preferred-lang');
    var lang = saved || (navigator.language || navigator.userLanguage || 'es').slice(0, 2).toLowerCase();
    if (lang === 'en') {
      document.querySelector('h1').textContent = "Oops, looks like we dissociated from something here.";
      document.querySelector('p').textContent = "The page you're looking for doesn't exist, moved away, or just needs a moment alone.";
      var btn = document.querySelector('.btn--primary');
      btn.textContent = 'Go back home';
      btn.href = '/en/';
      document.documentElement.lang = 'en';
    }
  </script>
</body>
</html>
