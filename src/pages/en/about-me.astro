---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import StatsBand from '../../components/StatsBand.astro';
import PermanenceCurve from '../../components/PermanenceCurve.astro';
import { t } from '../../i18n/utils';
import { personSchema } from '../../data/person';

const locale = 'en';
const i = t(locale);

const schema = personSchema(locale);
---

<Base
  title="About me | Patricio Ruiz Abrín, somatic-based therapist, training in systemic therapy"
  description="Meet Patricio Ruiz Abrín, a somatic-based therapist, training in systemic therapy, in Mexico City and online: his training, his perspective, and how he accompanies each process."
  altPath="/sobre-mi/"
  ogImage="/uploads/og/about-me.webp"
  schema={schema}
  nav="photo"
>

  <!-- HERO -->
  <SiteHeader
    variant="cinema"
    titleCompact
    eyebrow="Somatic-based therapist · Mexico City and online"
    title="I'm Patricio Ruiz Abrín, a somatic-based therapist."
    photo="/uploads/patricio-ruiz-retrato-2.jpg"
    photoDesktop="/uploads/hero-crops/patricio-ruiz-retrato-2-hero-cinema.jpg"
    photoAlt="Patricio Ruiz Abrín, therapist"
    ctaLabel="Book your first session"
    ctaHref="https://wa.me/patriciomx"
  >
    <p><strong>Feel at home in yourself.</strong></p>
    <p>I help you reconnect with your intuition and your capacity to self-regulate, through an approach that integrates mind, emotion, and body.</p>
  </SiteHeader>

  <StatsBand
    eyebrow="My practice in numbers"
    lede="9 years accompanying individual processes · 6 years with couples · 2 years with families"
    stats={[
      { value: 138, label: 'people have taken a process of 4 or more sessions' },
      { value: 3180, label: 'sessions make up those processes' },
      { value: 6, suffix: '–30 sessions', label: 'make up the average process (20th–80th percentile)' },
    ]}
  >
    <PermanenceCurve
      title="How long I work with the people I see"
      axisY="Number of processes that reached each session"
      axisX="Session number →"
      bandLabel="2 out of 3 processes live here: between session 6 and 33"
      barTitle={(processes, session) => `${processes} process${processes === 1 ? '' : 'es'} reached session ${session}`}
      summary="Permanence curve: of 138 processes, Isolated themes, 4–11 sessions, 47%; Brief processes, 12–23 sessions, 23%; Complex themes, 24–47 sessions, 18%; A life path, 48 sessions or more, 12%. The middle two thirds live between sessions 6 and 33."
      legend={[
        { name: 'Isolated themes', examples: 'first interviews, accidents, injuries, one-off guidance', range: '4–11 sessions', pct: 47, time: 'about 3 months' },
        { name: 'Brief processes', examples: 'integration, injuries, breakups', range: '12–23 sessions', pct: 23, time: 'about 8 months' },
        { name: 'Complex themes', range: '24–47 sessions', pct: 18, time: 'a year and a half' },
        { name: 'A life path', range: '48 sessions or more', pct: 12, time: 'two and a half years' },
      ]}
    />
  </StatsBand>

  <style>
    :global(.site-header__lead strong) { color: #E6D2B4; }

    .technique-pill {
      background: var(--purple);
      color: #fff;
      font-weight: 600;
      font-size: 13px;
      padding: 8px 18px;
      border-radius: var(--r-pill);
    }
    .meta-label {
      margin: 0 0 3px;
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0;
      text-transform: none;
      color: var(--sand-d);
    }
  </style>

  <!-- APPROACH -->
  <section id="enfoque" class="section zone-dark">
    <div class="container">
      <p data-reveal class="label-section">My approach</p>
      <h2 data-reveal class="heading-section" style="color:var(--heading-canvas);">Commitment, responsibility, and experience</h2>
      <h3 data-reveal style="font-family:'Bitter',serif;font-weight:500;color:var(--accent-canvas);font-size:clamp(19px,2vw,24px);line-height:1.3;margin:16px 0 28px;">How I work</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px 48px;">
        <p data-reveal class="body-text" style="margin:0 0 20px;grid-column:1 / -1;color:var(--on-canvas);">I work with adolescents and adults in individual therapy, couples, families, growth groups, and organizations.</p>
        <p data-reveal class="body-text" style="margin:0;grid-column:1 / -1;color:var(--on-canvas);">My training is broad by design, not by indecision: Somatic Experiencing, IFS, Core Energetics, EFT, and systemic training in progress. I don't work with a menu of approaches — I work with a map. Every person arrives with a different level of access to their body, their emotions, and their narratives, and a first task of therapy is to find where your system can most readily begin. Sometimes it's bodily sensation; sometimes it's the internal parts; sometimes it's the family stories and rules. What doesn't change is the foundation: strengthening the capacity for self-regulation as the path toward re-signification and, in turn, toward deep change.</p>
      </div>
      <div data-reveal style="margin-top:36px;">
        <p class="label-section label-section--plain" style="color:var(--on-canvas);margin:0 0 16px;">Approaches I integrate</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <span class="technique-pill">Somatic Experiencing (SE)</span>
          <span class="technique-pill">Internal Family Systems (IFS)</span>
          <span class="technique-pill">Core Energetics</span>
          <span class="technique-pill">Systemic Family Therapy</span>
        </div>
      </div>
      <div data-reveal style="margin-top:28px;">
        <p class="label-section label-section--plain" style="color:var(--on-canvas);margin:0 0 16px;">Technique</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <span class="technique-pill">Tapping (EFT)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TRAINING -->
  <section id="formacion" class="section zone-dark">
    <div class="container">
      <p data-reveal class="label-section">Background</p>
      <h2 data-reveal class="heading-section" style="margin-bottom:48px;color:var(--heading-canvas);">My training and experience</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:40px;">

        <div data-reveal>
          <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:20px;margin:0 0 22px;padding-bottom:12px;border-bottom:2px solid var(--accent-canvas);">Degrees</h3>
          <div style="display:flex;flex-direction:column;gap:16px;">
            <div>
              <p class="meta-label">2015</p>
              <p style="margin:0;font-size:15px;font-weight:600;color:var(--on-canvas);">Architect</p>
              <p style="margin:0;font-size:14px;color:var(--on-canvas-soft);">Facultad de Arquitectura, UNAM</p>
            </div>
            <div>
              <p class="meta-label">2025-26 · in progress</p>
              <p style="margin:0;font-size:15px;font-weight:600;color:var(--on-canvas);">Master's in Systemic Family Therapy</p>
              <p style="margin:0;font-size:14px;color:var(--on-canvas-soft);">Instituto Crisol</p>
            </div>
          </div>
        </div>

        <div data-reveal>
          <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:20px;margin:0 0 22px;padding-bottom:12px;border-bottom:2px solid var(--accent-canvas);">Specialized training</h3>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">2015-18</p>
              <p style="margin:0;font-size:15px;color:var(--on-canvas);line-height:1.4;">Core Energetics Practitioner + Postgraduate — Instituto Corpore</p>
            </div>
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">2019-20</p>
              <p style="margin:0;font-size:15px;color:var(--on-canvas);line-height:1.4;">Person-Centered Approach Specialization — IHPG</p>
            </div>
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">2022-24</p>
              <p style="margin:0;font-size:15px;color:var(--on-canvas);line-height:1.4;"><a href="https://portal.traumahealing.org/s/searchdirectory" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;font-weight:600;">Somatic Experiencing Practitioner</a> — <a href="https://experienciasomaticamexico.com/terapeutas/patricio-michel-ruiz-abrin/" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;font-weight:600;">Experiencia Somática México</a></p>
            </div>
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">Ongoing studies</p>
              <ul style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:4px;list-style:disc;">
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">IFS</li>
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">EFT</li>
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">Exceptional Marriage</li>
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">Reiki Usui Level 3</li>
              </ul>
            </div>
          </div>
        </div>

        <div data-reveal>
          <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:20px;margin:0 0 22px;padding-bottom:12px;border-bottom:2px solid var(--accent-canvas);">Teaching and facilitation</h3>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <ul style="margin:6px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:5px;list-style:disc;">
              <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Lead instructor at Instituto Corpore since 2026</li>
              <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Group facilitator since 2018</li>
              <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">5 editions of the "Menos es más" workshop</li>
            </ul>
            <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border-hair);">
              <p class="meta-label" style="margin:0 0 8px;color:var(--accent-canvas);">Teaching assistant in the training programs of</p>
              <ul style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:5px;list-style:disc;">
                <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Instituto Corpore 12th Cohort</li>
                <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Experiencia Somática México 5th Cohort</li>
                <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Experiencia Somática Uruguay 14th Cohort</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="zone-light" style="position:relative;overflow:hidden;background:transparent;padding:clamp(64px,9vw,112px) 32px;">
    <div class="container">
      <div data-reveal style="position:relative;max-width:700px;">
        <h2 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:clamp(28px,4vw,50px);line-height:1.08;margin:0 0 20px;text-wrap:balance;">Do you want to take the first step?</h2>
        <p style="font-size:clamp(15px,1.1vw,18px);line-height:1.65;color:var(--on-canvas-soft);margin:0 0 32px;max-width:50ch;">Every process begins with a conversation. Reach out and let's see, with no commitment, if this accompaniment is right for you.</p>
        <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--secondary">Book your first session</a>
      </div>
    </div>
  </section>

</Base>
