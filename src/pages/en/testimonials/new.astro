---
// HIDDEN page: noindex, out of the sitemap and nav. Share by direct link only.
import Base from '../../../layouts/Base.astro';
import { RI_API, RI_TOKEN } from '../../../data/red-config';
---

<Base
  title="Share your experience — Inessentia"
  description="Private form to share your therapy testimonial."
  noindex
  hideFooter
>
  <style>
    .rt-title{font-family:'Bitter',serif;font-size:2rem;color:var(--heading);font-weight:700;margin:0 0 6px}
    .rt-sub{font-size:.9rem;color:var(--text-faint);line-height:1.6;margin:0 0 32px}
    .rt-row{display:flex;gap:14px;flex-wrap:wrap}
    .rt-row>.form-field{flex:1;min-width:180px}
    .form-textarea{min-height:140px;resize:vertical}
    .rt-consent{display:flex;align-items:flex-start;gap:10px;font-size:.85rem;line-height:1.55;color:var(--text-soft);cursor:pointer;user-select:none}
    .rt-consent input{margin-top:3px;accent-color:var(--wine)}
    .form-msg{display:none;margin-top:16px;font-size:.88rem;line-height:1.5}
    .form-msg.ok,.form-msg.err{display:block}
    .rt-count{font-size:.72rem;color:var(--text-faint);text-align:right;margin-top:4px}
  </style>

  <div class="form-wrap zone-dark">
    <h1 class="rt-title">Share your <em style="color:var(--gold);">experience</em></h1>
    <p class="rt-sub">
      Thank you for wanting to share your process. Your testimonial helps others feel encouraged
      to start their own. It's reviewed before being published on <a href="/en/testimonials/" class="link-inline">the testimonials page</a>.
      You can sign it with your name, initials, or as "Anonymous".
    </p>

    <form id="rt-form" novalidate>
      <div class="form-field">
        <label class="form-label" for="t-testimonio">Your testimonial *</label>
        <textarea class="form-textarea" id="t-testimonio" maxlength="600" required
          placeholder="How did you get here? What has changed in you or your life through the process?"></textarea>
        <div class="rt-count"><span id="t-count">0</span>/600</div>
      </div>

      <div class="rt-row">
        <div class="form-field">
          <label class="form-label" for="t-nombre">Your name *</label>
          <input class="form-input" id="t-nombre" required>
        </div>
        <div class="form-field">
          <label class="form-label" for="t-publicar">Publish as <small>— if you'd rather not use your name</small></label>
          <input class="form-input" id="t-publicar" placeholder="e.g. Anonymous, initials, nickname">
        </div>
      </div>

      <div class="rt-row">
        <div class="form-field">
          <label class="form-label" for="t-tipo">Type of process</label>
          <select class="form-select" id="t-tipo">
            <option value="">Prefer not to say</option>
            <option value="Individual therapy">Individual therapy</option>
            <option value="Couples therapy">Couples therapy</option>
            <option value="Family therapy">Family therapy</option>
          </select>
        </div>
        <div class="form-field">
          <label class="form-label" for="t-email">Email <small>— not published</small></label>
          <input class="form-input" id="t-email" type="email">
        </div>
      </div>

      <div class="form-field">
        <label class="form-label" for="t-link">Link <small>— optional: your site, Instagram or YouTube, if you'd like it to appear next to your name</small></label>
        <input class="form-input" id="t-link" placeholder="https://…">
      </div>

      <div class="form-field">
        <label class="rt-consent">
          <input type="checkbox" id="t-consent">
          <span>I authorize this testimonial to be published on inessentia.mx with the name I provided. I understand I can request its removal at any time. *</span>
        </label>
      </div>

      <button type="submit" class="btn btn--wine" id="rt-submit">Send my testimonial</button>
      <div class="form-msg" id="rt-msg"></div>
    </form>
  </div>

  <script is:inline define:vars={{ RI_API, RI_TOKEN }}>
    (function () {
      var form = document.getElementById('rt-form');
      var btn = document.getElementById('rt-submit');
      var msg = document.getElementById('rt-msg');
      var ta = document.getElementById('t-testimonio');
      var count = document.getElementById('t-count');

      ta.addEventListener('input', function () { count.textContent = ta.value.length; });

      function show(cls, text) { msg.className = 'form-msg ' + cls; msg.textContent = text; }

      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var testimonio = ta.value.trim();
        var nombre = document.getElementById('t-nombre').value.trim();
        var consent = document.getElementById('t-consent').checked;

        if (!testimonio || !nombre) { show('err', 'Required fields are missing (marked with *).'); return; }
        if (!consent) { show('err', 'We need your authorization to be able to publish the testimonial.'); return; }
        if (RI_API.indexOf('http') !== 0) { show('err', "The form isn't connected yet (RI_API not configured)."); return; }

        btn.disabled = true;
        btn.textContent = 'Sending…';

        fetch(RI_API, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({
            token: RI_TOKEN,
            form: 'testimonio',
            testimonio: testimonio,
            nombre: nombre,
            publicar_como: document.getElementById('t-publicar').value.trim() || nombre,
            tipo_terapia: document.getElementById('t-tipo').value,
            link: document.getElementById('t-link').value.trim(),
            email: document.getElementById('t-email').value.trim(),
            consentimiento: true,
            idioma: 'en'
          })
        }).then(function (r) { return r.json(); }).then(function (res) {
          if (res && res.ok) {
            show('ok', 'Thank you so much! We received your testimonial. Patricio will review it and it will appear published shortly.');
            form.reset();
            count.textContent = '0';
          } else {
            show('err', "Couldn't be sent. Please try again or write to us on WhatsApp.");
          }
        }).catch(function () {
          show('err', "Couldn't be sent. Please try again or write to us on WhatsApp.");
        }).finally(function () {
          btn.disabled = false;
          btn.textContent = 'Send my testimonial';
        });
      });
    })();
  </script>
</Base>
