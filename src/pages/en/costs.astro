---
import Base from '../../layouts/Base.astro';
import { sitePath } from '../../i18n/utils';

const locale = 'en';
const termsPath = sitePath(locale, 'terms');
---

<Base
  title="Costs | Inessentia"
  description="Clear rates to support you. Individual, couples, and family therapy share the same cost and duration. See the per-session price and the continuity pack."
  altPath="/costos/"
>

  <!-- HEADER -->
  <!-- ver es/testimonios.astro: .container--read (760, centrado) desalineaba
       el H1 del borde canónico; se anula el padding de .page-header--soft y
       se pasa al patrón de una sola caja (max-width + padding) que ya usan
       las secciones de esta página (ver costos-grid más abajo). -->
  <header class="page-header--soft zone-dark" style="padding-left:0;padding-right:0;">
    <div style="max-width:var(--container-pad-w);margin:0 auto;padding:0 var(--gutter);box-sizing:border-box;">
      <p class="label-section">Costs</p>
      <h1>Invest in your process</h1>
      <!-- max-width:54ch: al salir de .container--read (760) la caja pasó a
           --container-pad-w (hasta 1600), y sin tope la entradilla se estiraba
           a una línea de lectura demasiado larga. Mismo tope que ya usa la
           entradilla de testimonials.astro. -->
      <p class="body-text" style="margin:20px 0 0;max-width:54ch;">Clear rates to support you — whether you're starting today or keeping your process going with continuity.</p>
    </div>
  </header>

  <!-- BAND: SAME COST AND DURATION -->
  <section class="zone-dark" style="background:transparent;">
    <div data-reveal style="max-width:var(--container-pad-w);margin:0 auto;padding:20px var(--gutter);box-sizing:border-box;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-canvas)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <p style="margin:0;font-size:clamp(14px,1.1vw,16px);line-height:1.55;color:var(--on-canvas);">Individual, couples, and family sessions share the <strong>same cost</strong> and a duration of <strong>50 to 60 minutes</strong> each.</p>
    </div>
  </section>

  <!-- PRICING CARDS -->
  <section class="zone-dark" style="background:transparent;padding:clamp(48px,7vw,64px) 0 20px;">
    <div class="costos-grid" style="max-width:var(--container-pad-w);margin:0 auto;padding:0 var(--gutter);box-sizing:border-box;display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:stretch;">

      <!-- Per session -->
      <div data-reveal style="background:var(--surface);border:1px solid var(--border-card);border-radius:24px;padding:clamp(32px,4vw,44px) clamp(28px,3.5vw,40px);display:flex;flex-direction:column;box-shadow:0 24px 54px rgba(60,31,94,.10);">
        <p class="label-section">Per session</p>
        <h2 class="heading-section" style="font-size:var(--fs-h4);margin:0 0 28px;">First session and occasional sessions</h2>
        <div style="margin-top:auto;">
          <div style="display:flex;align-items:baseline;gap:8px;">
            <span style="font-family:var(--ff-head);font-weight:700;color:var(--heading);font-size:clamp(42px,5vw,52px);line-height:1;">$98</span>
            <span style="font-weight:700;font-size:15px;color:var(--text-faint);">usd*</span>
          </div>
          <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--gold" style="margin-top:26px;">Book a session<span class="btn__dot"></span></a>
        </div>
      </div>

      <!-- 4 sessions -->
      <div data-reveal class="on-dark" style="position:relative;background:var(--purple);border-radius:24px;padding:clamp(32px,4vw,44px) clamp(28px,3.5vw,40px);display:flex;flex-direction:column;box-shadow:0 30px 64px rgba(60,31,94,.28);">
        <div style="position:absolute;top:26px;right:26px;background:var(--sand);color:#2e1b12;font-weight:800;font-size:12px;letter-spacing:0;text-transform:none;padding:7px 14px;border-radius:99px;">Save 5%</div>
        <p class="label-section">Continuity</p>
        <h2 class="heading-section" style="font-size:var(--fs-h4);color:#fff;margin:0 0 6px;">4 sessions</h2>
        <p style="margin:0 0 28px;font-size:15px;line-height:1.5;color:rgba(255,255,255,.72);">Weekly or biweekly recurrence.</p>
        <div style="margin-top:auto;">
          <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;">
            <span style="font-family:var(--ff-head);font-weight:500;color:rgba(255,255,255,.55);font-size:26px;line-height:1;text-decoration:line-through;">$392</span>
            <span style="display:flex;align-items:baseline;gap:8px;">
              <span style="font-family:var(--ff-head);font-weight:700;color:#fff;font-size:clamp(42px,5vw,52px);line-height:1;">$369</span>
              <span style="font-weight:700;font-size:15px;color:var(--sand);">usd*</span>
            </span>
          </div>
          <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--secondary" style="margin-top:26px;">Reserve your pack</a>
        </div>
      </div>

    </div>
  </section>

  <!-- NOTE — zone-dark on purpose (not zone-light): on a short page like this
       one, the canvas is still wine/magenta at this scroll depth, not crema;
       the light-theme override forces dark text anyway, so zone-dark is the
       safe choice in both cases. -->
  <section class="zone-dark" style="background:transparent;padding:14px 0 clamp(56px,8vw,80px);">
    <div data-reveal style="max-width:var(--container-pad-w);margin:0 auto;padding:0 var(--gutter);box-sizing:border-box;">
      <div style="border-top:1px solid var(--border-hair);padding-top:22px;max-width:78ch;">
        <p style="margin:0 0 8px;font-size:14px;line-height:1.65;color:var(--on-canvas-faint);">* Payments are processed by bank transfer or Stripe. Paying in advance confirms your slot; you can also pay in cash on the day of your session.</p>
        <p style="margin:0;font-size:14px;line-height:1.65;color:var(--on-canvas-soft);">See more details in the <a href={termsPath} class="link-inline">terms of service</a>.</p>
      </div>
    </div>
  </section>

</Base>

<style>
  @media (max-width: 720px) {
    .costos-grid { grid-template-columns: 1fr !important; }
  }
</style>
</content>
