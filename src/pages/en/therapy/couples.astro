---
import { waLink } from '../../../data/contacto';
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { t } from '../../../i18n/utils';
import { BUSINESS_ID } from '../../../data/person';

const locale = 'en';
const i = t(locale);

const WA_COUPLES = waLink("Hi Patricio, I'm interested in scheduling a first couples session. Can we talk?");
const PAGE_URL = 'https://inessentia.mx/en/therapy/couples/';

// Preguntas frecuentes: el mismo arreglo pinta la sección y el FAQPage del
// schema, para que nunca digan cosas distintas. Sólo datos que dio Patricio.
const faqs = [
  {
    q: 'Where do sessions take place?',
    a: 'In person in Nápoles, Mexico City, or online by video call.',
  },
  {
    q: 'Can we do couples therapy in English?',
    a: 'Yes. Sessions are in English or Spanish, whichever feels more natural to the two of you.',
  },
  {
    q: 'Do you work with international couples or couples who have relocated to Mexico?',
    a: 'Yes. I work with multicultural and international couples, and with couples going through a move or relocation: what it does to the relationship when one partner followed the other, when family is far away, or when two cultures meet in everyday life.',
  },
  {
    q: 'Do you work with LGBTQ+ and neurodivergent couples?',
    a: 'Yes. I work with LGBTQ+ couples and with couples where one or both partners are neurodivergent. We look at how each of you experiences the relationship, rather than measuring it against a single model of how a couple should be.',
  },
  {
    q: 'How often do we meet, and for how long?',
    a: 'Sessions are typically biweekly and last about one hour. During times of crisis we can consider weekly sessions.',
  },
  {
    q: 'How much does it cost?',
    a: 'Fees for couples sessions are listed on the costs page.',
    link: { href: '/en/costs/', label: 'See the costs' },
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${PAGE_URL}#service`,
      'name': 'Couples therapy',
      'serviceType': 'Couples therapy',
      'url': PAGE_URL,
      'provider': { '@id': BUSINESS_ID },
      'areaServed': [
        { '@type': 'City', 'name': 'Mexico City' },
        { '@type': 'Place', 'name': 'Online' },
      ],
      'availableLanguage': ['en', 'es'],
      'audience': { '@type': 'Audience', 'audienceType': 'Couples' },
    },
    {
      '@type': 'FAQPage',
      '@id': `${PAGE_URL}#faq`,
      'mainEntity': faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    },
  ],
};
---

<Base
  title="Couples therapy with a relational approach | Mexico City & online"
  description="Support for couples: communication, bonding and conflict from a relational and body-centered approach. In-person sessions in Mexico City and online."
  altPath="/terapia/pareja/"
  ogImage="/uploads/og/therapy-couples.webp"
  schema={schema}
>

  <!-- HERO -->
  <SiteHeader
    variant="panel"
    panelLarge
    eyebrow="Couples therapy"
    icon="/uploads/icono-terapia-pareja.webp"
    iconSize="clamp(132px, 10vw, 175px)"
    title="A safe space to reconnect with your life partner."
    ctaLabel="Book your first couples session"
    ctaHref={WA_COUPLES}
    secondaryLabel="What is the first session like?"
    secondaryHref="#primera-sesion"
  >
    <p>For couples caught in the same arguments, who've grown apart, or who are working to rebuild broken trust to reconnect.</p>
    <p>Dating relationships, domestic partnerships and marriages · Nápoles, Mexico City &amp; online</p>
  </SiteHeader>

  <!-- IS THIS FOR YOU? -->
  <section class="section section--cream zone-dark">
    <div class="container">
      <div data-reveal class="section-header">
        <p class="label-section">Indications</p>
        <h2 class="heading-section">Is this therapy right for you?</h2>
      </div>
      <div class="two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:32px;">
        <div data-reveal class="card card--pad-a">
          <p class="label-section label-section--plain" style="color:var(--heading);margin:0 0 20px;">It is for you if...</p>
          <div style="display:flex;flex-direction:column;gap:13px;">
            <div style="display:flex;gap:12px;"><span style="color:var(--heading);font-weight:700;font-size:18px;flex:none;line-height:1.4;">✓</span><p class="body-text" style="margin:0;">You want to strengthen your relationship before a major step: marriage, children, moving in together.</p></div>
            <div style="display:flex;gap:12px;"><span style="color:var(--heading);font-weight:700;font-size:18px;flex:none;line-height:1.4;">✓</span><p class="body-text" style="margin:0;">The arrival or departure of children changed your dynamic and you can't find a way to reconnect or redefine yourselves.</p></div>
            <div style="display:flex;gap:12px;"><span style="color:var(--heading);font-weight:700;font-size:18px;flex:none;line-height:1.4;">✓</span><p class="body-text" style="margin:0;">You keep having the same arguments over and over and can't find a way out.</p></div>
            <div style="display:flex;gap:12px;"><span style="color:var(--heading);font-weight:700;font-size:18px;flex:none;line-height:1.4;">✓</span><p class="body-text" style="margin:0;">You feel emotionally distant: you're together but disconnected.</p></div>
            <div style="display:flex;gap:12px;"><span style="color:var(--heading);font-weight:700;font-size:18px;flex:none;line-height:1.4;">✓</span><p class="body-text" style="margin:0;">Something happened that broke your trust and you can't find a way to repair or move forward.</p></div>
            <div style="display:flex;gap:12px;"><span style="color:var(--heading);font-weight:700;font-size:18px;flex:none;line-height:1.4;">✓</span><p class="body-text" style="margin:0;">You're considering separating and want to bring closure under the best possible conditions.</p></div>
          </div>
        </div>
        <div data-reveal class="card card--pad-a">
          <p class="label-section label-section--plain" style="margin:0 0 20px;">It is not for you if...</p>
          <div style="display:flex;flex-direction:column;gap:13px;">
            <div style="display:flex;gap:12px;"><span style="color:var(--accent-canvas);font-weight:700;font-size:18px;flex:none;line-height:1.4;">–</span><p class="body-text" style="margin:0;">You need legal mediation, arbitration or divorce management. I can point you to the right resource.</p></div>
            <div style="display:flex;gap:12px;"><span style="color:var(--accent-canvas);font-weight:700;font-size:18px;flex:none;line-height:1.4;">–</span><p class="body-text" style="margin:0;">There is active, recurring physical or psychological violence of a structural nature.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO I WORK WITH -->
  <section class="section zone-dark">
    <div class="container--narrow">
      <p data-reveal class="label-section">Who I work with</p>
      <h2 data-reveal class="heading-section" style="margin-bottom:28px;">Couples therapy in English in Mexico City</h2>
      <div style="display:flex;flex-direction:column;gap:18px;">
        <p data-reveal class="body-text" style="margin:0;">Sessions can be held in English or Spanish. Many of the couples I accompany live between two languages, two cultures or two countries, and the relationship carries that too.</p>
        <ul data-reveal class="couples-who">
          <li><strong>Multicultural and international couples</strong>, where each partner brings a different idea of family, closeness and how conflict is handled.</li>
          <li><strong>Couples who have relocated</strong> to Mexico City, or are preparing to move: when one partner followed the other, when family and friends are far away, when everyday life has to be rebuilt from scratch.</li>
          <li><strong>LGBTQ+ couples.</strong></li>
          <li><strong>Neurodivergent couples</strong>, where one or both partners experience the world, and the relationship, in a different way.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section zone-dark">
    <div class="container--narrow">
      <p data-reveal class="label-section">The process</p>
      <h2 data-reveal class="heading-section" style="margin-bottom:28px;">Rhythm, depth and method</h2>
      <div style="display:flex;flex-direction:column;gap:18px;">
        <p data-reveal class="body-text" style="margin:0;">In the first session I carry out an assessment by exploring the couple's history with both of you. I take the side of what I believe can support the relationship: I work with it as a third entity -- something that belongs to and is the responsibility of both, and that with support and commitment can transform for the benefit of both.</p>
        <p data-reveal class="body-text" style="margin:0;">We weave a conversation where the goal is not to convince the other person whose pain matters more, but to understand how the couple is hurting from the way it is functioning, and what each partner can do to tend to and repair the friction in the bond.</p>
        <p data-reveal class="body-text" style="margin:0;">Sessions are typically biweekly, lasting approximately one hour. During times of crisis we can consider weekly sessions. We can meet in person in Napoles or online with the same depth.</p>
      </div>
    </div>
  </section>

  <!-- 3 TRANSFORMATIONS -->
  <section class="section section--cream zone-dark">
    <div class="container">
      <div data-reveal class="section-header">
        <p class="label-section">Evolution</p>
        <h2 class="heading-section">What changes as the process unfolds</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:24px;">
        <div data-reveal class="card card--pad-b">
          <span style="font-family:var(--ff-head);font-weight:700;font-size:48px;color:var(--cream);line-height:1;">1</span>
          <h3 style="font-family:var(--ff-head);font-weight:700;color:var(--heading-canvas);font-size:22px;margin:0;">From argument to relational listening</h3>
          <p class="body-text" style="margin:0;">Recurring arguments are not the problem -- they are the symptom. When you can name what is happening in your body in the moment of conflict, it becomes possible to interrupt the cycle.</p>
        </div>
        <div data-reveal class="card card--pad-b">
          <span style="font-family:var(--ff-head);font-weight:700;font-size:48px;color:var(--cream);line-height:1;">2</span>
          <h3 style="font-family:var(--ff-head);font-weight:700;color:var(--heading-canvas);font-size:22px;margin:0;">A relationship that holds you</h3>
          <p class="body-text" style="margin:0;">The shared vocabulary, the tools to navigate conflict and the trust that you can get through hard things together -- you take all of that with you. The relationship as refuge, resource and safe place.</p>
        </div>
        <div data-reveal class="card card--pad-b">
          <span style="font-family:var(--ff-head);font-weight:700;font-size:48px;color:var(--cream);line-height:1;">3</span>
          <h3 style="font-family:var(--ff-head);font-weight:700;color:var(--heading-canvas);font-size:22px;margin:0;">Recovering intimacy</h3>
          <p class="body-text" style="margin:0;">Emotional distance is built through small disconnections. As the process unfolds, you begin to recognize each other again: knowing what hurts, what provides security, what you need -- and asking for it without falling into an endless argument.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FIRST SESSION + COST -->
  <section id="primera-sesion" class="section zone-dark zone-dark--warm">
    <div class="container">
        <p data-reveal class="label-section">Your first session</p>
        <h2 data-reveal style="font-family:var(--ff-head);font-weight:700;color:var(--heading);font-size:clamp(26px,3.5vw,40px);line-height:1.1;margin:0 0 28px;">Step by step</h2>
        <div data-reveal style="display:flex;flex-direction:column;gap:0;">
          <div style="display:flex;gap:16px;padding-bottom:22px;">
            <div class="step-circle-wrap"><span class="step-circle">1</span><span class="step-connector"></span></div>
            <p style="margin:0;font-size:15px;line-height:1.65;color:var(--text);padding-top:5px;">One of you reaches out via WhatsApp. We clarify any questions about scheduling and payment. Confirmation 48 hours in advance.</p>
          </div>
          <div style="display:flex;gap:16px;padding-bottom:22px;">
            <div class="step-circle-wrap"><span class="step-circle">2</span><span class="step-connector"></span></div>
            <p style="margin:0;font-size:15px;line-height:1.65;color:var(--text);padding-top:5px;">The first session is a mutual interview. We define what you expect from the process and set realistic expectations.</p>
          </div>
          <div style="display:flex;gap:16px;padding-bottom:22px;">
            <div class="step-circle-wrap"><span class="step-circle">3</span><span class="step-connector"></span></div>
            <p style="margin:0;font-size:15px;line-height:1.65;color:var(--text);padding-top:5px;">The first 3 to 6 sessions are an adjustment period: we calibrate how the space feels for each of you.</p>
          </div>
          <div style="display:flex;gap:16px;">
            <span class="step-circle">4</span>
            <p style="margin:0;font-size:15px;line-height:1.65;color:var(--text);padding-top:5px;">We schedule in two-month periods with clear goals and constantly recalibrate progress.</p>
          </div>
        </div>
        <div data-reveal style="display:flex;flex-direction:column;gap:14px;margin-top:40px;">
          <div style="background:var(--cream-2);border-radius:18px;padding:22px 24px;">
            <div style="font-family:var(--ff-body);font-size:38px;line-height:.6;color:var(--sand);margin-bottom:8px;">“</div>
            <p style="font-size:15px;line-height:1.6;color:var(--text);margin:0 0 10px;">We learned to communicate better, to feel confident expressing our differences in a respectful way.</p>
            <p style="margin:0;font-family:var(--ff-head);font-weight:700;color:var(--heading);font-size:15px;">M + R</p>
          </div>
          <div style="background:var(--cream-2);border-radius:18px;padding:22px 24px;">
            <div style="font-family:var(--ff-body);font-size:38px;line-height:.6;color:var(--sand);margin-bottom:8px;">“</div>
            <p style="font-size:15px;line-height:1.6;color:var(--text);margin:0 0 10px;">Patricio always supported us and created a wonderfully harmonious environment where we could open up and talk with respect.</p>
            <p style="margin:0;font-family:var(--ff-head);font-weight:700;color:var(--heading);font-size:15px;">Nay</p>
          </div>
        </div>
    </div>
  </section>

  <!-- APPROACHES -->
  <section class="section section--purple zone-dark zone-dark--warm">
    <div class="container">
      <div data-reveal class="section-header">
        <p class="label-section label-section--on-dark">Approaches</p>
        <h2 class="heading-section heading-section--on-dark">How I work in session</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:20px;">
        <div data-reveal style="background:var(--surface);border:1px solid var(--border-card);border-radius:var(--r-card);padding:28px 24px;">
          <h3 style="font-family:var(--ff-head);font-weight:700;color:var(--gold);font-size:17px;margin:0 0 10px;">Systemic Family Therapy</h3>
          <p class="body-text body-text--on-dark" style="font-size:14px;margin:0;">The backbone of my relational work. It focuses on interactions as the visible expression of the bond's health. It integrates resources from Gottman, Sue Johnson's Emotionally Focused Therapy and postmodern models.</p>
        </div>
        <div data-reveal style="background:var(--surface);border:1px solid var(--border-card);border-radius:var(--r-card);padding:28px 24px;">
          <h3 style="font-family:var(--ff-head);font-weight:700;color:var(--gold);font-size:17px;margin:0 0 10px;">Somatic Experiencing (SE)</h3>
          <p class="body-text body-text--on-dark" style="font-size:14px;margin:0;">It pays attention to the nervous system responses of each partner and the dynamic between you. It helps regulate what the body holds before it can be processed with words.</p>
        </div>
        <div data-reveal style="background:var(--surface);border:1px solid var(--border-card);border-radius:var(--r-card);padding:28px 24px;">
          <h3 style="font-family:var(--ff-head);font-weight:700;color:var(--gold);font-size:17px;margin:0 0 10px;">IFS -- Internal Family Systems</h3>
          <p class="body-text body-text--on-dark" style="font-size:14px;margin:0;">It works with the internal "parts" each partner brings to the relationship. When each person recognizes their parts, they stop projecting them onto the other.</p>
        </div>
        <div data-reveal style="background:var(--surface);border:1px solid var(--border-card);border-radius:var(--r-card);padding:28px 24px;">
          <h3 style="font-family:var(--ff-head);font-weight:700;color:var(--gold);font-size:17px;margin:0 0 10px;">Core Energetics / Exceptional Marriage</h3>
          <p class="body-text body-text--on-dark" style="font-size:14px;margin:0;">A couples model derived from Core Energetics. It works with the body, emotions and relational patterns to facilitate free self-expression in a context of connection and safety.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHERE + FAQ -->
  <section class="section zone-dark">
    <div data-reveal class="container--narrow on-light couples-faq-panel">
      <p class="label-section">Where we meet</p>
      <h2 class="heading-section" style="margin-bottom:24px;">In Nápoles, Mexico City, or online</h2>
      <div class="couples-where">
        <div>
          <h3>In person</h3>
          <p class="body-text">My office is in the Nápoles neighborhood, in Mexico City. Being in the same room lets us work with what happens between you in the moment: posture, distance, the way you look at each other.</p>
        </div>
        <div>
          <h3>Online</h3>
          <p class="body-text">By video call, with the same depth. It works for couples outside Mexico City, for couples who are traveling or living apart for a while, and for those who simply prefer it.</p>
        </div>
      </div>

      <p class="label-section" style="margin-top:48px;">Questions</p>
      <h2 class="heading-section" style="margin-bottom:28px;">Frequently asked questions</h2>
      <div class="couples-faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="body-text">{f.a}{f.link && <> <a href={f.link.href} class="link-inline">{f.link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA + CROSS-SELL -->
  <section class="section section--purple zone-light">
    <div data-reveal class="container--narrow" style="max-width:700px;">
      <h2 style="font-family:var(--ff-head);font-weight:700;color:var(--heading-canvas);font-size:clamp(28px,4vw,48px);line-height:1.08;margin:0 0 20px;text-wrap:balance;">Ready to book your first session?</h2>
      <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
        <a href={WA_COUPLES} target="_blank" rel="noopener" class="btn btn--secondary">Book your first couples session</a>
        <a href="/en/costs/" class="link-underline">See the costs</a>
      </div>
      <p style="margin:30px 0 10px;color:var(--on-canvas-soft);font-size:15px;">Thinking about an individual process?</p>
      <a href="/en/therapy/individual/" class="link-underline">Learn about my individual therapy</a>
    </div>
  </section>

</Base>

<style>
  /* Lugar + FAQ caen en el cruce 79→84 del lienzo (medido: FAQ sola en 76–87 % a 1280; Approaches en 78–80 % a 375 si «Where» iba arriba), donde
     ningún color de texto pasa AA. Por eso va en isla .on-light con fondo
     propio, como manda el comentario de --page-grad en global.css. */
  .couples-faq-panel { background: var(--surface); border-radius: var(--r-panel); padding: clamp(28px, 4vw, 48px); box-shadow: var(--sh-card); }
  .couples-who { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: var(--sp-3); }
  .couples-who li { font-size: var(--fs-body); line-height: var(--lh-body); color: var(--text); }
  .couples-who strong { color: var(--heading); }
  .couples-where { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: var(--sp-5) 32px; }
  .couples-where h3 { font-family: var(--ff-head); font-weight: 700; color: var(--heading); font-size: var(--fs-h4); line-height: var(--lh-head); margin: 0 0 var(--sp-2); }
  .couples-where p { margin: 0; }
  .couples-faq { display: flex; flex-direction: column; border-top: 1px solid var(--border-hair); }
  .couples-faq details { border-bottom: 1px solid var(--border-hair); }
  .couples-faq summary {
    cursor: pointer; list-style: none; padding: var(--sp-5) 32px var(--sp-5) 0; position: relative;
    font-family: var(--ff-head); font-weight: 700; color: var(--heading); font-size: var(--fs-h4); line-height: var(--lh-head);
  }
  .couples-faq summary::-webkit-details-marker { display: none; }
  .couples-faq summary::after { content: '+'; position: absolute; right: 4px; top: var(--sp-5); color: var(--sand-d); font-family: var(--ff-body); }
  .couples-faq details[open] summary::after { content: '–'; }
  .couples-faq p { margin: 0 0 var(--sp-5); }
</style>
