---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { personRef, BUSINESS_ID } from '../../data/person';
import SupNav from '../../components/supervision/SupNav.astro';
import SupFooter from '../../components/supervision/SupFooter.astro';
import SesionesRail from '../../components/supervision/SesionesRail.astro';
import SupSupervisa from '../../components/supervision/SupSupervisa.astro';
import { sesiones, memoriaPath, minutos, SUPERVISION_WA as WA, LLAMADO } from '../../data/supervision';

const CANONICAL = 'https://inessentia.mx/es/supervision/';

// Memorias ya publicadas, la más reciente primero.
const memorias = sesiones.filter((x) => x.memoria).reverse();

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EducationEvent",
  "name": "Grupo de Actualización en Terapia Corporal",
  "description": "Supervisión de casos y ética del acompañamiento para la comunidad Córpore. 9 sesiones, octubre 2026 – febrero 2027, CDMX y en línea.",
  "startDate": "2026-10-03T09:30:00-06:00",
  "endDate": "2027-02-13T13:30:00-06:00",
  "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "maximumAttendeeCapacity": 12,
  "location": [
    {
      "@type": "Place",
      "name": "Inessentia",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Georgia 114, Oficina 303",
        "addressLocality": "Nápoles, Benito Juárez",
        "postalCode": "03840",
        "addressRegion": "CDMX",
        "addressCountry": "MX"
      }
    },
    {
      "@type": "VirtualLocation",
      "url": "https://meet.google.com/"
    }
  ],
  "performer": personRef,
  "organizer": {
    "@id": BUSINESS_ID,
    "@type": "Organization",
    "name": "Inessentia",
    "url": "https://inessentia.mx/es/"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "MXN",
    "lowPrice": 1500,
    "highPrice": 11130,
    "availability": "https://schema.org/LimitedAvailability",
    "url": CANONICAL
  },
  "url": CANONICAL
};

const pilares = [
  {
    num: 1,
    title: '¿Qué te llevas?',
    items: [
      '9 sesiones de supervisión en vivo, con casos reales de tu propia práctica',
      'Un recorrido completo por los 7 temas de "The Ethics of Caring": dinero, sexualidad, poder, amor, verdad, insight y unidad',
      'Rutas de trabajo y opciones de seguimiento para cada caso, revisadas por el equipo a lo largo del ciclo',
      'Una comunidad de práctica sostenida durante 5 meses',
    ],
  },
  {
    num: 2,
    title: '¿Por qué es útil?',
    items: [
      'La ética del acompañamiento se sostiene en comunidad y frente a casos reales, no en la teoría',
      'La supervisión en vivo da retroalimentación inmediata, no hipotética',
      'El marco de Kylea Taylor es una referencia central para trabajar con estados no ordinarios de consciencia',
      'El formato híbrido da profundidad sin sacrificar accesibilidad',
    ],
  },
  {
    num: 3,
    title: '¿Cómo te apoya?',
    items: [
      'Un espacio regular, cada 15 días, que sostiene la continuidad de tu proceso y el de tus consultantes',
      'Un equipo terapéutico que acompaña tus decisiones clínicas — no estás sola/o frente al caso',
      'Devoluciones y seguimiento revisados a lo largo de todo el ciclo, no una sola vez',
    ],
  },
];

// El recorrido y el calendario salen de src/data/supervision.ts. La sesión n
// trata el tema n-1 del libro (la 1 es la introducción, la 9 el cierre).
const recorridoBase = sesiones.map((x) => ({ n: String(x.n - 1), label: x.tema }));
const recorrido = recorridoBase.map((s, i, arr) => ({
  ...s,
  arrow: i < arr.length - 1,
  extreme: i === 0 || i === arr.length - 1,
}));

const fechas = sesiones.map((x) => ({ n: x.n, fecha: x.fecha, nota: x.nota }));

const PRICING = {
  eyebrow: 'Inversión',
  titulo: 'Tu lugar en el grupo',
  subtitulo: 'El ciclo ya empezó y todavía puedes sumarte. Completo incluye las 9 sesiones, de octubre de 2026 a febrero de 2027. El precio destacado es el de efectivo o transferencia; con tarjeta de crédito aplica el precio de lista (tachado).',
  planes: [
    {
      tag: null,
      titulo: 'Pago único',
      subtitulo: 'Un solo pago por el ciclo completo',
      precioTachado: '$11,130 con tarjeta',
      precioGrande: '$10,500',
      notaPrecio: 'Efectivo o transferencia',
      textoLibre: null,
    },
  ],
  notaCupo: 'máximo 12 personas.',
  corpore: {
    titulo: 'Estudiantes del Instituto Córpore',
    texto: 'Para quienes están en proceso de certificación. Se integran por sesión suelta o por bloque de 5 (la introducción + 4 sesiones). Solo efectivo o transferencia — no se acepta tarjeta de crédito. Si no se integran desde la primera sesión, hace falta una entrevista previa y ver el video de introducción para entender el encuadre.',
    tiers: [
      { condicion: 'Sesión suelta, efectivo o transferencia', precio: '$1,500 / sesión' },
      { condicion: 'Bloque de 5 sesiones (intro + 4), efectivo o transferencia', precio: '$7,200 (4% desc.)', destacado: true },
    ],
  },
};
---

<Base
  hideNav
  hideFooter
  noAltLocale
  title="Grupo de Actualización en Terapia Corporal | Supervisión de casos — Inessentia"
  description="Supervisión de casos y ética del acompañamiento para la comunidad Córpore. 9 sesiones, octubre 2026 – febrero 2027, CDMX y en línea, con Patricio Ruiz."
  canonical={CANONICAL}
  ogImage="/uploads/og/supervision.webp"
  schema={eventSchema}
>
  <div class="gl-page">

    <SupNav links={[
      { href: '#programa', label: 'Programa' },
      { href: '#memorias', label: 'Memorias' },
      { href: '#fechas', label: 'Fechas' },
      { href: '#inversion', label: 'Inversión' },
    ]} />

    <!-- HERO -->
    <section class="gl-hero zone-dark">
      <Img
        src="/uploads/supervision-grupo-conversacion.webp"
        alt="Conversación de supervisión entre practicantes en Inessentia"
        loading="eager"
        fetchpriority="high"
        minWidth={960}
        sizes="100vw"
        class="gl-hero-img"
      />
      <div class="gl-hero-veil"></div>
      <div class="gl-hero-content">
        <div class="gl-hero-top">
          <p class="gl-eyebrow-gold">Comunidad Córpore</p>
          <div class="gl-hero-meta">
            <span>9 sesiones · oct 2026 – feb 2027</span>
            <span class="gl-dot"></span>
            <span>Cupo máximo 12 personas</span>
            <span class="gl-dot"></span>
            <span>Modalidad híbrida</span>
          </div>
        </div>
        <div class="gl-hero-bottom">
          <h1 class="gl-h1">Grupo de Actualización en Terapia Corporal</h1>
          <p class="gl-subtitle">Supervisión de casos + ética del acompañamiento</p>
          {memorias[0] && (
            <a class="gl-hero-aviso" href={memoriaPath(memorias[0].n)}>
              <span class="gl-hero-aviso-tag">Ya empezamos</span>
              <span>Lee la memoria de la sesión {memorias[0].n} y escucha el resumen →</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- PARA QUIÉN -->
    <!-- zone-dark explícito (antes: sin zona). Estas secciones caían al
         default de :root[data-theme="dark"], que hoy coincide con .zone-dark
         por casualidad — no por declaración. Medido: todo el texto sobre
         lienzo de esta página termina en 74.8% (1280px) / 71.7% (375px), o
         sea del lado oscuro del cruce 79→84; el amanecer no llega hasta las
         dos secciones de cierre, que sí traen zone-light. Declararlo evita
         que un cambio en el default de tema las voltee en silencio. -->
    <section class="section zone-dark">
      <div class="container--narrow" style="max-width:820px;">
        <p class="label-section">¿Para quién es esto?</p>
        <h2 class="heading-section" style="margin:0 0 24px;">Un espacio para sostener y profundizar tu práctica en comunidad</h2>
        <p class="body-text" style="max-width:60ch;font-size:18px;">Dirigido a la comunidad de Córpore: practicantes certificadas/os que quieran sostener y profundizar su práctica, con un equipo que respalda sus decisiones clínicas.</p>
        <p class="gl-italic-note">Basado en <em>&ldquo;The Ethics of Caring&rdquo;</em> de Kylea Taylor.</p>
        <p class="gl-italic-note">Lectura de entrada: <a href="/es/blog/presencia-alianza-mirada-permiso/" class="link-inline">Presencia, alianza, mirada y permiso</a>, una introducción a la supervisión grupal.</p>
      </div>
    </section>

    <!-- PILARES -->
    <section class="section section--cream gl-bordered zone-dark">
      <div class="container">
        <div style="max-width:640px;margin-bottom:48px;">
          <p class="label-section">Lo esencial</p>
          <h2 class="heading-section" style="margin:0;">Tres razones para sostener tu práctica aquí</h2>
        </div>
        <div class="gl-grid-3">
          {pilares.map((p) => (
            <div class="gl-card">
              <span class="gl-badge">{p.num}</span>
              <h3 class="gl-card-title">{p.title}</h3>
              <ul class="gl-list">
                {p.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROGRAMA -->
    <section id="programa" class="section zone-dark">
      <div class="container">
      <div style="max-width:680px;margin-bottom:14px;">
        <p class="label-section">¿Qué haremos?</p>
        <h2 class="heading-section" style="margin:0 0 18px;">Un ciclo de 9 sesiones siguiendo los 7 temas de la ética del cuidado</h2>
        <p class="body-text" style="font-size:17px;">Cada capítulo de <em>&ldquo;The Ethics of Caring&rdquo;</em> de Kylea Taylor abre un espacio de reflexión colectiva y de supervisión en vivo con casos reales.</p>
      </div>

      <div style="margin:36px 0 44px;">
        <p class="gl-mini-label">El recorrido, sesión a sesión</p>
        <div class="gl-recorrido">
          {recorrido.map((s) => (
            <div class="gl-parada">
              <div class="gl-pill">
                <span class:list={['gl-pill-dot', 'on-dark', { 'gl-pill-dot--gold': s.extreme }]}>{s.n}</span>
                <span class="gl-pill-label">{s.label}</span>
              </div>
              {s.arrow && <span class="gl-arrow" aria-hidden="true">·</span>}
            </div>
          ))}
        </div>

        <div class="gl-transversal">
          <span class="gl-transversal-tag">Transversal</span>
          <span class="gl-transversal-text">La <strong>ética y el trabajo con estados no ordinarios de consciencia</strong> atraviesan todas las sesiones: no son un tema aparte, sino el hilo que sostiene cada encuentro.</span>
        </div>
      </div>

      <div class="gl-grid-2">
        <div class="gl-card">
          <h3 class="gl-card-title" style="font-size:22px;">Reflexión grupal</h3>
          <p class="body-text" style="font-size:16px;margin:0;">Revisión de cada capítulo del libro como espacio de reflexión colectiva, conectando la teoría ética con la práctica cotidiana del acompañamiento.</p>
        </div>
        <div class="gl-card">
          <h3 class="gl-card-title" style="font-size:22px;">Supervisión en vivo</h3>
          <p class="body-text" style="font-size:16px;margin:0;">Cada integrante puede traer a un consultante a sesión. El equipo terapéutico establece rutas de trabajo para apoyar la facilitación y propone opciones de seguimiento, revisadas a lo largo del ciclo.</p>
        </div>
      </div>
      </div>
    </section>

    <!-- MEMORIAS -->
    <section id="memorias" class="section zone-dark zone-dark--warm">
      <div class="container">
        <div style="max-width:680px;margin-bottom:36px;">
          <p class="label-section">Memorias del ciclo</p>
          <h2 class="heading-section" style="margin:0 0 18px;">Lo que vamos trabajando, sesión a sesión</h2>
          <p class="body-text" style="font-size:17px;">Después de cada encuentro publico una memoria con las ideas que trabajamos, el texto que leímos y un resumen en audio para repasar. Sirve a quienes están en el grupo y a quienes quieren asomarse antes de sumarse.</p>
        </div>

        {memorias.map((x) => (
          <a class="gl-memoria" href={memoriaPath(x.n)}>
            <span class="gl-memoria-n">Sesión {x.n} · {x.tema} · {x.fecha.toLowerCase()}</span>
            <span class="gl-memoria-titulo">{x.memoria!.titulo}</span>
            <span class="gl-memoria-bajada">{x.memoria!.bajada}</span>
            <span class="gl-memoria-incluye">
              <span>Memoria</span>
              {x.audio && <span>Resumen en audio · {minutos(x.audio.segundos)}</span>}
              {x.lectura && <span>Lectura: {x.lectura.titulo}</span>}
            </span>
            <span class="gl-memoria-ir">Leer la memoria →</span>
          </a>
        ))}

        <div style="margin-top:28px;">
          <SesionesRail />
        </div>
      </div>
    </section>

    <!-- COMUNIDAD -->
    <section class="section zone-dark zone-dark--warm">
      <div class="container">
        <p class="gl-eyebrow-gold" style="margin-bottom:16px;">Una comunidad de práctica</p>
        <h2 class="heading-section" style="margin:0 0 40px;">Cinco meses sosteniéndonos en presencia</h2>
        <div class="gl-photo-frame">
          <Img
            src="/uploads/supervision-grupos-trabajando.webp"
            alt="Pequeños grupos de supervisión trabajando en Inessentia"
            loading="lazy"
            sizes="(max-width: 1280px) 100vw, 1120px"
          />
        </div>
      </div>
    </section>

    <!-- FECHAS -->
    <section id="fechas" class="section section--cream gl-bordered zone-dark zone-dark--warm">
      <div class="container--narrow">
        <div style="max-width:680px;margin-bottom:40px;">
          <p class="label-section">Fechas y logística</p>
          <h2 class="heading-section" style="margin:0 0 16px;">Sábados cada 15 días, 9:30 a 13:30 h</h2>
          <p class="body-text" style="font-size:17px;">4 horas por sesión, 36 horas totales a lo largo del ciclo.</p>
        </div>

        <div class="gl-table-wrap">
          <table class="gl-table">
            <thead class="on-dark">
              <tr>
                <th style="width:56px;">#</th>
                <th>Fecha</th>
                <th>Nota</th>
              </tr>
            </thead>
            <tbody>
              {fechas.map((row, i) => (
                <tr class={i % 2 === 1 ? 'gl-row-alt' : ''}>
                  <td class="gl-td-n">{row.n}</td>
                  <td>{row.fecha}</td>
                  <td class="gl-td-nota">{row.nota}</td>
                </tr>
              ))}
              <tr>
                <td colspan="3" class="gl-td-receso">Receso decembrino: 13 de diciembre – 8 de enero</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="gl-grid-3 gl-grid-3--tight">
          <div class="gl-mini-card">
            <div class="gl-mini-card-label">Modalidad</div>
            <div class="gl-mini-card-value">Híbrida — presencial en Inessentia y en línea por Meet</div>
          </div>
          <div class="gl-mini-card">
            <div class="gl-mini-card-label">Cupo</div>
            <div class="gl-mini-card-value">Máximo 12 personas</div>
          </div>
          <div class="gl-mini-card">
            <div class="gl-mini-card-label">Inscripciones</div>
            <div class="gl-mini-card-value">Abiertas: el ciclo ya empezó y todavía puedes sumarte</div>
          </div>
        </div>
      </div>
    </section>

    <!-- INVERSIÓN -->
    <section id="inversion" class="section zone-dark zone-dark--warm">
      <div class="container">
      <div style="max-width:680px;margin-bottom:44px;">
        <p class="label-section">{PRICING.eyebrow}</p>
        <h2 class="heading-section" style="margin:0 0 16px;">{PRICING.titulo}</h2>
        <p class="body-text" style="font-size:17px;">{PRICING.subtitulo}</p>
      </div>

      <div class="gl-grid-2">
        {PRICING.planes.map((plan, i) => (
          <div class:list={['gl-price-card', 'on-dark', { 'gl-price-card--featured': i === 0 }]}>
            {plan.tag && <span class="gl-price-tag">{plan.tag}</span>}
            <h3 class="gl-card-title" style="font-size:22px;">{plan.titulo}</h3>
            <p class="gl-price-subtitle">{plan.subtitulo}</p>
            {plan.precioTachado && <p class="gl-price-strike">{plan.precioTachado}</p>}
            <p class="gl-price-big">{plan.precioGrande}</p>
            <p class="gl-price-note">{plan.notaPrecio}</p>
            {plan.textoLibre && <p class="gl-price-free">{plan.textoLibre}</p>}
          </div>
        ))}
      </div>

      <div class="gl-notes-box">
        <p><strong>Cupo:</strong> {PRICING.notaCupo}</p>
      </div>

      <!-- on-dark en las tarjetas de precio y en este recuadro: quedan en el cruce
           79→84 del lienzo, y la --surface del tema es translúcida, así que
           sin superficie propia su texto claro caía sobre arena. -->
      <div class="gl-corpore-callout on-dark">
        <h3 class="gl-card-title" style="font-size:21px;">{PRICING.corpore.titulo}</h3>
        <p class="body-text" style="margin:0 0 22px;">{PRICING.corpore.texto}</p>
        <div class="gl-corpore-tiers">
          {PRICING.corpore.tiers.map((tier) => (
            <div class:list={['gl-corpore-tier', { 'gl-corpore-tier--featured': tier.destacado }]}>
              <span class="gl-corpore-tier-cond">{tier.condicion}</span>
              <span class="gl-corpore-tier-precio">{tier.precio}</span>
            </div>
          ))}
        </div>
      </div>
      </div>
    </section>

    <!-- SUPERVISA -->
    <section class="section section--cream zone-light" style="border-top:1px solid var(--cream);">
      <div class="container--narrow">
        <SupSupervisa />
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="section section--purple zone-light">
      <div class="container--narrow" style="max-width:820px;">
        <h2 class="heading-section">{LLAMADO.titulo}</h2>
        <p style="font-size:18px;line-height:1.7;color:var(--on-canvas-soft);margin:0 0 34px;max-width:52ch;">{LLAMADO.texto} Cupo limitado a 12 personas.</p>
        <a href={WA} target="_blank" rel="noopener" class="btn btn--gold">{LLAMADO.boton}<span class="btn__dot"></span></a>
      </div>
    </section>

    <SupFooter />

  </div>
</Base>

<style>
  .gl-page {
    width: 100%;
  }

  /* HERO — vive sobre el lienzo continuo (--page-grad): no pinta su propio
     fondo sólido, declara zone-dark en el marcado para resolver el color de
     texto correcto (la foto + velo siguen dando el contraste real). */
  .gl-hero {
    position: relative;
    min-height: 820px;
    overflow: hidden;
    background: transparent;
    display: flex;
    flex-direction: column;
    /* El velo terminaba en un morado casi opaco FIJO que chocaba contra el
       navy del lienzo justo debajo (dos morados distintos, borde duro —
       la "mezcla rara de colores"). Se disuelve hacia transparent en el
       último tramo para fundirse con el lienzo, igual que el hero principal. */
    mask-image: linear-gradient(180deg, #000 0%, #000 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 80%, transparent 100%);
  }
  .gl-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  .gl-hero-veil {
    /* Antes --veil-blue: 10,12,40 (navy propio de esta página). Se
       homologa a --veil-purple (= --canvas-top en triplete), el arranque
       canónico del lienzo: si el lienzo abre en morado en todas las
       páginas, el velo de supervision.astro también. */
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--veil-purple),.92) 0%, rgba(var(--veil-purple),.78) 20%, rgba(var(--veil-purple),.28) 40%, rgba(var(--veil-purple),.22) 58%, rgba(var(--veil-purple),.72) 82%, rgba(var(--veil-purple),.94) 100%);
  }
  @media (max-width: 680px) {
    .gl-hero-veil {
      background: linear-gradient(180deg, rgba(var(--veil-purple),.9) 0%, rgba(var(--veil-purple),.82) 45%, rgba(var(--veil-purple),.86) 100%);
    }
  }
  .gl-hero-content {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* Mismo ancho/gutter que el resto de las secciones (.container +
       .section) para que el hero no quede desalineado respecto al resto
       de la página. Padding-top con aire generoso bajo el .gl-nav fijo
       (~114px de alto sin scroll). */
    max-width: var(--container-pad-w);
    width: 100%;
    margin: 0 auto;
    padding: clamp(160px, 15vw, 200px) var(--gutter) 60px;
  }
  .gl-hero-top { max-width: 900px; }
  .gl-eyebrow-gold {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--accent-canvas);
    margin: 0 0 14px;
  }
  .gl-hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
  }
  .gl-hero-meta span { color: var(--on-canvas); font-size: 14px; font-weight: 600; }
  .gl-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--accent-canvas); }
  .gl-hero-bottom { max-width: 820px; margin-right: auto; text-align: left; }
  .gl-h1 {
    font-family: var(--ff-head);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.03;
    color: var(--heading-canvas);
    letter-spacing: 0;
    margin: 0;
    text-wrap: balance;
  }
  .gl-subtitle {
    font-family: var(--ff-head);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(18px, 2.4vw, 24px);
    color: var(--accent-canvas);
    margin: 18px 0 0;
  }

  .gl-italic-note {
    font-size: 14px;
    font-style: italic;
    color: var(--text-muted);
    margin: 24px 0 0;
  }

  .gl-bordered { border-top: 1px solid var(--border-card); border-bottom: 1px solid var(--border-card); }

