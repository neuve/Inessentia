---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const locale = 'es';
---

<Base
  title="Paga y confirma tu sesión | Inessentia"
  description="Completa el pago de tu sesión de forma segura con Stripe y confirma tu cita con Patricio Ruiz Abrín."
  altPath="/pay/"
>

  <!-- HERO -->
  <SiteHeader
    variant="panel"
    eyebrow="Pago seguro"
    icon="/uploads/logo-icon.webp"
    iconSize="96px"
    title="Paga y confirma tu sesión"
    ctaLabel="Ir a pagar"
    ctaHref="https://buy.stripe.com/fZu8wPaMmgD58S1euw3sI0c"
  >
    <p>Completa tu pago de forma segura a través de Stripe. En cuanto se confirme, tu sesión queda agendada.</p>
  </SiteHeader>

  <!-- AYUDA -->
  <section class="section">
    <div class="container--narrow">
      <p style="font-size:15px;line-height:1.7;color:var(--text-muted);margin:0;max-width:600px;">¿Tienes dudas sobre tu pago o tu cita? Escríbeme por <a href="https://wa.me/patriciomx?text=Hola%20Patricio%2C%20tengo%20una%20duda%20sobre%20mi%20pago." target="_blank" rel="noopener" class="link-inline">WhatsApp</a>.</p>
    </div>
  </section>

</Base>
