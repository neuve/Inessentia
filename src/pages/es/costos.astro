---
import Base from '../../layouts/Base.astro';
import { sitePath } from '../../i18n/utils';

const locale = 'es';
const termsPath = sitePath(locale, 'terms');
---

<Base
  title="Costos | Inessentia"
  description="Tarifas claras para acompañarte. Individual, pareja y familia comparten el mismo costo y duración. Consulta el precio por sesión y el paquete de continuidad."
  altPath="/costs/"
  nav="solid"
>

  <!-- HEADER -->
  <header class="page-header--soft">
    <div class="container--read">
      <p class="label-section">Costos</p>
      <h1>Invierte en tu proceso</h1>
      <p class="body-text" style="margin:20px 0 0;">Tarifas claras para acompañarte, ya sea que empieces hoy o sostengas tu proceso con continuidad.</p>
    </div>
  </header>

  <!-- BANDA: MISMO COSTO Y DURACIÓN -->
  <section class="on-light" style="background:var(--cream);border-bottom:1px solid rgba(70,39,110,.10);">
    <div data-reveal style="max-width:var(--container-w);margin:0 auto;padding:20px 40px;box-sizing:border-box;display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center;text-align:center;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--wine)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <p style="margin:0;font-size:clamp(14px,1.1vw,16px);line-height:1.55;color:var(--text);">Individual, pareja y familia comparten el <strong>mismo costo</strong> y una duración de <strong>50 a 60 minutos</strong> por sesión.</p>
    </div>
  </section>

  <!-- TARJETAS DE PRECIO -->
  <section style="background:var(--cream-2);padding:clamp(48px,7vw,64px) 0 20px;">
    <div class="costos-grid" style="max-width:var(--container-w);margin:0 auto;padding:0 40px;box-sizing:border-box;display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:stretch;">

      <!-- Por sesión -->
      <div data-reveal style="background:var(--surface);border:1px solid var(--border-card);border-radius:24px;padding:clamp(32px,4vw,44px) clamp(28px,3.5vw,40px);display:flex;flex-direction:column;box-shadow:0 24px 54px rgba(60,31,94,.10);">
        <p style="margin:0 0 16px;font-weight:700;font-size:12px;letter-spacing:0;text-transform:none;color:var(--wine);">Por sesión</p>
        <h2 class="heading-section" style="font-size:var(--fs-h4);margin:0 0 28px;">Primera sesión y sesiones esporádicas</h2>
        <div style="margin-top:auto;">
          <div style="display:flex;align-items:baseline;gap:8px;">
            <span style="font-family:var(--ff-head);font-weight:700;color:var(--heading);font-size:clamp(42px,5vw,52px);line-height:1;">$1,700</span>
            <span style="font-weight:700;font-size:15px;color:var(--text-faint);">mxp*</span>
          </div>
          <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--gold" style="margin-top:26px;">Agenda cita<span class="btn__dot"></span></a>
        </div>
      </div>

      <!-- 4 sesiones -->
      <div data-reveal class="on-dark" style="position:relative;background:var(--purple);border-radius:24px;padding:clamp(32px,4vw,44px) clamp(28px,3.5vw,40px);display:flex;flex-direction:column;box-shadow:0 30px 64px rgba(60,31,94,.28);">
        <div style="position:absolute;top:26px;right:26px;background:var(--sand);color:#2e1b12;font-weight:800;font-size:12px;letter-spacing:0;text-transform:none;padding:7px 14px;border-radius:99px;">Ahorra 5%</div>
        <p style="margin:0 0 16px;font-weight:700;font-size:12px;letter-spacing:0;text-transform:none;color:var(--sand);">Continuidad</p>
        <h2 class="heading-section" style="font-size:var(--fs-h4);color:#fff;margin:0 0 6px;">4 sesiones</h2>
        <p style="margin:0 0 28px;font-size:15px;line-height:1.5;color:rgba(255,255,255,.72);">Recurrencia semanal o quincenal.</p>
        <div style="margin-top:auto;">
          <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;">
            <span style="font-family:var(--ff-head);font-weight:500;color:rgba(255,255,255,.55);font-size:26px;line-height:1;text-decoration:line-through;">$6,800</span>
            <span style="display:flex;align-items:baseline;gap:8px;">
              <span style="font-family:var(--ff-head);font-weight:700;color:#fff;font-size:clamp(42px,5vw,52px);line-height:1;">$6,398</span>
              <span style="font-weight:700;font-size:15px;color:var(--sand);">mxp*</span>
            </span>
          </div>
          <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--white" style="margin-top:26px;">Reserva tu pack</a>
        </div>
      </div>

    </div>
  </section>

  <!-- NOTA -->
  <section style="background:var(--cream-2);padding:14px 0 clamp(56px,8vw,80px);">
    <div data-reveal style="max-width:var(--container-w);margin:0 auto;padding:0 40px;box-sizing:border-box;">
      <div style="border-top:1px solid var(--border-hair);padding-top:22px;max-width:78ch;">
        <p style="margin:0 0 8px;font-size:14px;line-height:1.65;color:var(--text-muted);">* Los pagos se procesan por transferencia bancaria (SPEI) o Stripe. El pago anticipado confirma tu lugar; también puedes cubrirlo en efectivo el día de tu sesión.</p>
        <p style="margin:0;font-size:14px;line-height:1.65;color:var(--text-muted);">Consulta más detalles en los <a href={termsPath} class="link-underline">términos del servicio</a>.</p>
      </div>
    </div>
  </section>

</Base>

<style>
  @media (max-width: 720px) {
    .costos-grid { grid-template-columns: 1fr !important; }
  }
</style>
</content>
