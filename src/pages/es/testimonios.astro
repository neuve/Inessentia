---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/utils';
import { testimonials } from '../../data/testimonials';
import { RI_API } from '../../data/red-config';

const locale = 'es';
const i = t(locale);
const items = testimonials[locale];
---

<Base
  title="Testimonios | Experiencias reales en terapia con Patricio Ruiz"
  description="Personas reales comparten su experiencia en terapia individual, de pareja y familiar con Patricio Ruiz Abrin, desde un enfoque de base somática."
  altPath="/testimonials/"
  nav="solid"
>

  <!-- HEADER -->
  <header class="page-header--soft zone-dark">
    <div class="container--read">
      <p class="label-section" style="color:var(--accent-canvas);">Experiencias</p>
      <h1 style="margin:0 0 22px;text-wrap:balance;color:var(--heading-canvas);">Personas reales, cambios reales</h1>
      <p class="body-text" style="margin:0;max-width:54ch;color:var(--on-canvas);">Lo que cuentan quienes han hecho su proceso conmigo. Cada historia es distinta — esto es solo una muestra.</p>
    </div>
  </header>

  <!-- CAROUSEL -->
  <section style="padding:clamp(40px,6vw,72px) 0 clamp(64px,9vw,120px);">
    <div style="max-width:var(--container-pad-w);margin:0 auto;padding:0 var(--gutter);box-sizing:border-box;">
      <div id="t-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:24px;align-items:start;">
        <div class="t-slot" style="transition:opacity .6s ease;opacity:1;"></div>
        <div class="t-slot" style="transition:opacity .6s ease;opacity:1;"></div>
        <div class="t-slot" style="transition:opacity .6s ease;opacity:1;"></div>
      </div>
      <div id="t-dots" style="display:flex;gap:9px;justify-content:center;margin-top:34px;"></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="zone-light" style="background:transparent;padding:clamp(56px,8vw,100px) 0;">
    <div style="max-width:var(--container-pad-w);margin:0 auto;padding:0 var(--gutter);box-sizing:border-box;">
      <div style="max-width:640px;">
        <h2 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:clamp(26px,4vw,46px);line-height:1.08;margin:0 0 20px;text-wrap:balance;">Tu historia puede ser la siguiente</h2>
        <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--gold">Agenda tu primera cita<span class="btn__dot"></span></a>
      </div>
    </div>
  </section>

  <script type="application/json" id="t-data" set:html={JSON.stringify(items)}></script>
  <script is:inline define:vars={{ RI_API }}>window.RI_API = RI_API;</script>
  <script>
    import { initTestimonialCarousel } from '../../scripts/testimonial-carousel.js';
    const dataEl = document.getElementById('t-data');
    const items = dataEl ? JSON.parse(dataEl.textContent) : [];

    function init(all) {
      initTestimonialCarousel({ gridSel: '#t-grid', slotSel: '.t-slot', dotsSel: '#t-dots', items: all, dotStyle: 'flat' });
    }

    // Suma los testimonios nuevos aprobados en la hoja (Apps Script).
    // Si falla o no hay API configurada, muestra solo los curados del código.
    const api = (window as any).RI_API || '';
    if (api.indexOf('http') === 0) {
      fetch(api + '?form=testimonios&idioma=es')
        .then((r) => r.json())
        .then((extra) => init(Array.isArray(extra) && extra.length ? items.concat(extra) : items))
        .catch(() => init(items));
    } else {
      init(items);
    }
  </script>

</Base>
