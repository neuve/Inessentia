---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import StatsBand from '../../components/StatsBand.astro';
import PermanenceCurve from '../../components/PermanenceCurve.astro';
import { t } from '../../i18n/utils';
import { personSchema } from '../../data/person';

const locale = 'es';
const i = t(locale);

const schema = personSchema(locale);
---

<Base
  title="Sobre mí | Patricio Ruiz Abrín, terapeuta de base somática y en formación sistémica"
  description="Conoce a Patricio Ruiz Abrín, terapeuta de base somática, en formación sistémica, en CDMX y en línea: su formación, su mirada y cómo acompaña cada proceso."
  altPath="/about-me/"
  ogImage="/uploads/og/sobre-mi.webp"
  schema={schema}
  nav="photo"
>

  <!-- HERO -->
  <SiteHeader
    variant="cinema"
    titleCompact
    eyebrow="Terapeuta de base somática · CDMX y en línea"
    title="Soy Patricio Ruiz Abrín, terapeuta de base somática."
    photo="/uploads/patricio-ruiz-retrato-2.jpg"
    photoDesktop="/uploads/hero-crops/patricio-ruiz-retrato-2-hero-cinema.jpg"
    photoAlt="Retrato de Patricio Ruiz Abrín, terapeuta, persona adulta joven de tez media y cabello oscuro con semblante apacible y mirada cálida"
    ctaLabel="Agenda tu primera cita"
    ctaHref="https://wa.me/patriciomx"
  >
    <p><strong>Siéntete en casa contigo.</strong></p>
    <p>Te acompaño a recuperar la conexión con tu intuición y tu capacidad de autorregularte, desde un enfoque que integra mente, emoción y cuerpo.</p>
  </SiteHeader>

  <StatsBand
    eyebrow="Mi práctica en números"
    lede="9 años acompañando procesos individuales · 6 años con parejas · 2 años con familias"
    stats={[
      { value: 138, label: 'personas han tomado un proceso de 4 sesiones o más' },
      { value: 3180, label: 'sesiones componen esos procesos' },
      { value: 6, suffix: '–30 sesiones', label: 'componen el proceso promedio (percentiles 20 a 80)' },
    ]}
  >
    <PermanenceCurve
      title="Cuánto tiempo trabajo con mis consultantes"
      axisY="Cantidad de procesos que llegaron a cada sesión"
      axisX="Número de sesión →"
      bandLabel="Aquí viven 2 de cada 3 procesos: entre la sesión 6 y la 33"
      legend={[
        { name: 'Temas aislados', examples: 'primeras entrevistas, accidentes, lesiones, asesorías', range: '4–11 sesiones', pct: 47, time: 'unos 3 meses' },
        { name: 'Temas breves', examples: 'integración, lesiones, rupturas', range: '12–23 sesiones', pct: 23, time: 'unos 8 meses' },
        { name: 'Temas complejos', range: '24–47 sesiones', pct: 18, time: 'año y medio' },
        { name: 'Camino de vida', range: '48 sesiones o más', pct: 12, time: 'dos años y medio' },
      ]}
    />
  </StatsBand>


  <style>
    :global(.site-header__lead strong) { color: #E6D2B4; }

    .technique-pill {
      background: var(--purple);
      color: #fff;
      font-weight: 600;
      font-size: 13px;
      padding: 8px 18px;
      border-radius: var(--r-pill);
    }
    .meta-label {
      margin: 0 0 3px;
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0;
      text-transform: none;
      color: var(--sand-d);
    }
  </style>

  <!-- ENFOQUE -->
  <section id="enfoque" class="section zone-dark">
    <div class="container">
      <p data-reveal class="label-section">Mi enfoque</p>
      <h2 data-reveal class="heading-section" style="color:var(--heading-canvas);">Compromiso, responsabilidad y experiencia</h2>
      <h3 data-reveal style="font-family:'Bitter',serif;font-weight:500;color:var(--accent-canvas);font-size:clamp(19px,2vw,24px);line-height:1.3;margin:16px 0 28px;">Las modalidades de trabajo</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px 48px;">
        <p data-reveal class="body-text" style="margin:0 0 20px;grid-column:1 / -1;color:var(--on-canvas);">Acompaño a adolescentes y adultos en proceso individual, a parejas, a familias, y a grupos de crecimiento y organizaciones.</p>
        <p data-reveal class="body-text" style="margin:0;grid-column:1 / -1;color:var(--on-canvas);">Mi formación es amplia por diseño, no por indecisión: Somatic Experiencing, IFS, Core Energetics, EFT y formación sistémica en curso. No trabajo con un menú de abordajes —trabajo con un mapa. Toda persona llega con un nivel distinto de acceso a su cuerpo, a sus emociones y a sus narrativas, y una primera tarea de la terapia es encontrar por dónde tu sistema tiene facilidad para acceder. A veces es la sensación corporal; a veces son las partes internas; a veces son las historias y reglas familiares. Lo que no cambia es el fundamento: el fortalecimiento de la capacidad de autorregulación como camino para la resignificación y, en consecuencia, para el cambio profundo.</p>
      </div>
      <div data-reveal style="margin-top:36px;">
        <p class="label-section label-section--plain" style="color:var(--on-canvas);margin:0 0 16px;">Abordajes que integro</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <span class="technique-pill">Experiencia Somática (SE)</span>
          <span class="technique-pill">Sistemas Familiares Internos (IFS)</span>
          <span class="technique-pill">Core Energética</span>
          <span class="technique-pill">Terapia Familiar Sistémica</span>
        </div>
      </div>
      <div data-reveal style="margin-top:28px;">
        <p class="label-section label-section--plain" style="color:var(--on-canvas);margin:0 0 16px;">Técnica</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <span class="technique-pill">Tapping (EFT)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMACION -->
  <section id="formacion" class="section zone-dark">
    <div class="container">
      <p data-reveal class="label-section">Trayectoria</p>
      <h2 data-reveal class="heading-section" style="margin-bottom:48px;color:var(--heading-canvas);">Mi formación y experiencia</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:40px;">

        <div data-reveal>
          <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:20px;margin:0 0 22px;padding-bottom:12px;border-bottom:2px solid var(--accent-canvas);opacity:1;">Titulación</h3>
          <div style="display:flex;flex-direction:column;gap:16px;">
            <div>
              <p class="meta-label">2015</p>
              <p style="margin:0;font-size:15px;font-weight:600;color:var(--on-canvas);">Arquitecto</p>
              <p style="margin:0;font-size:14px;color:var(--on-canvas-soft);">Facultad de Arquitectura, UNAM</p>
            </div>
            <div>
              <p class="meta-label">2025-26 · en curso</p>
              <p style="margin:0;font-size:15px;font-weight:600;color:var(--on-canvas);">Maestría en Terapia Familiar Sistémica</p>
              <p style="margin:0;font-size:14px;color:var(--on-canvas-soft);">Instituto Crisol</p>
            </div>
          </div>
        </div>

        <div data-reveal>
          <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:20px;margin:0 0 22px;padding-bottom:12px;border-bottom:2px solid var(--accent-canvas);">Formación especializada</h3>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">2015-18</p>
              <p style="margin:0;font-size:15px;color:var(--on-canvas);line-height:1.4;">Core Energetics Practitioner + Posgrado — Instituto Córpore</p>
            </div>
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">2019-20</p>
              <p style="margin:0;font-size:15px;color:var(--on-canvas);line-height:1.4;">Especialidad en Enfoque Centrado en la Persona — IHPG</p>
            </div>
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">2022-24</p>
              <p style="margin:0;font-size:15px;color:var(--on-canvas);line-height:1.4;"><a href="https://portal.traumahealing.org/s/searchdirectory" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;font-weight:600;">Somatic Experiencing Practitioner</a> — <a href="https://experienciasomaticamexico.com/terapeutas/patricio-michel-ruiz-abrin/" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;font-weight:600;">Experiencia Somática México</a></p>
            </div>
            <div>
              <p class="meta-label" style="margin:0 0 2px;color:var(--accent-canvas);">Estudios continuos</p>
              <ul style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:4px;list-style:disc;">
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">IFS</li>
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">EFT</li>
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">Exceptional Marriage</li>
                <li style="font-size:15px;color:var(--on-canvas);line-height:1.4;">Reiki Usui Nivel 3</li>
              </ul>
            </div>
          </div>
        </div>

        <div data-reveal>
          <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:20px;margin:0 0 22px;padding-bottom:12px;border-bottom:2px solid var(--accent-canvas);">Docencia y facilitación</h3>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <ul style="margin:6px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:5px;list-style:disc;">
              <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Maestro titular Instituto Córpore desde 2026</li>
              <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Facilitador de grupos desde 2018</li>
              <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">5 ediciones del taller "Menos es más"</li>
            </ul>
            <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border-hair);">
              <p class="meta-label" style="margin:0 0 8px;color:var(--accent-canvas);">Asistente en las formaciones de</p>
              <ul style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:5px;list-style:disc;">
                <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Instituto Córpore 12a Gen.</li>
                <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Experiencia Somática México 5a Gen.</li>
                <li style="font-size:14px;color:var(--on-canvas-soft);line-height:1.5;">Experiencia Somática Uruguay 14a Gen.</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="zone-light" style="position:relative;overflow:hidden;background:transparent;padding:clamp(64px,9vw,112px) 32px;">
    <div class="container">
      <div data-reveal style="position:relative;max-width:700px;">
        <h2 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:clamp(28px,4vw,50px);line-height:1.08;margin:0 0 20px;text-wrap:balance;">¿Quieres dar el primer paso?</h2>
        <p style="font-size:clamp(15px,1.1vw,18px);line-height:1.65;color:var(--on-canvas-soft);margin:0 0 32px;max-width:50ch;">Cada proceso empieza con una conversación. Escríbeme y vemos, sin compromiso, si este acompañamiento es para ti.</p>
        <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--secondary">Agenda tu primera cita</a>
      </div>
    </div>
  </section>

</Base>
