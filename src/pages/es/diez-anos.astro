---
import Base from '../../layouts/Base.astro';
import {
  hero, bandas, mesesDelAnio, horarios, modalidad, piramide, duracionPorGrupo,
  excluidos, corte, duracionCorta, mesesCortos, diasSemana, diasSemanaLargo,
  BANDAS_ORDEN, BANDAS_COLOR,
} from '../../lib/diez-anos';

const locale = 'es' as const;
const h = hero();
const b = bandas();
const m = mesesDelAnio();
const hor = horarios();
const mod = modalidad();
const pir = piramide();
const dur = duracionPorGrupo();
const exc = excluidos();

const MESES = mesesCortos(locale);
const DIAS = diasSemana(locale);
const DIA_LARGO = diasSemanaLargo(locale);

const BANDA_META: Record<string, { lbl: string; rango: string; desc: string }> = {
  inicial: { lbl: 'Trabajo inicial', rango: '1 a 3 sesiones', desc: 'Una consulta, una segunda opinión, algo que no llegó a arrancar.' },
  basico: { lbl: 'Trabajo básico', rango: '4 a 7 sesiones', desc: 'Un motivo acotado que se trabaja y se cierra: ya es proceso, todavía es corto.' },
  profundo: { lbl: 'Trabajo profundo', rango: '8 a 21 sesiones', desc: 'De un par de meses a un año. El terreno donde la mayoría del trabajo ocurre de verdad.' },
  vida: { lbl: 'Camino de vida', rango: '22 sesiones o más', desc: 'Procesos de años, con temporadas y regresos. Pocas personas, muchísimas sesiones.' },
};

const bandasTxt = `Proceso se compone de dos variables: número de sesiones (mayor a 1) y periodo de tiempo. De las ${b.total} personas de la década, la mitad rebasa las ${b.medianaGeneral.mediana_sesiones} sesiones y al menos asiste por ${duracionCorta(b.medianaGeneral.mediana_dias, locale)}.  Para esta estadística las medianas de tiempo dejan fuera ${b.personasUnaSesion} personas que asistieron una sola vez.`;

const llenosLbl = m.llenos.map((i) => MESES[i]).join(', ');
const flacosLbl = m.flacos.map((i) => MESES[i]).join(', ');
const anioTxt = `La consulta no es pareja a lo largo del año. Los meses en que más sesiones se toman son ${llenosLbl}; los más flacos, ${flacosLbl}. Un mes flaco es un mes con menos sesiones, no un mes sin datos: se cuentan sobre ${m.anioDesde}–${m.anioHasta}, los únicos cuatro años con calendario completo. Debajo, la misma pregunta a otra escala: en qué día y a qué hora de la semana caen esas sesiones.`;

const horTxt = `La hora más trabajada de la década es la de las ${hor.picoH}:00 del ${DIA_LARGO[hor.picoWd]}, con ${hor.picoN} sesiones. El morado crece con la raíz del conteo y no en línea recta: sin comprimir, las horas pico dejarían al resto de la rejilla en blanco.`;
const horFoot = `${hor.totalSched} de ${hor.totalAll} sesiones con horario registrado` + (hor.faltan > 0 ? ` · ${hor.faltan} sin horario.` : ' — todas.');

const mayor = mod.mayorPresencial ? 'presencial' : 'en línea';
const modTxt = `De ${mod.conDato} procesos con modalidad registrada, ${mod.presencial} fueron presenciales y ${mod.online} en línea; ${mod.hibrido} combinaron las dos. La consulta sigue siendo mayoritariamente ${mayor}. ` +
  (mod.sinDato ? `Quedan fuera ${mod.sinDato} procesos sin modalidad anotada, y también los que ` : 'Quedan fuera los procesos que ') +
  'no llegaron a tres sesiones: en una o dos citas no se elige una forma de trabajar, se toma la que había ese día.';

const pirTxt = `A esta consulta la buscan sobre todo mujeres: ${pir.totM} de las ${pir.dentro} personas del retrato, el ${pir.dentro ? Math.round((100 * pir.totM) / pir.dentro) : 0}%, frente a ${pir.totH} hombres. La edad es la que tenían en su PRIMERA sesión, no la de hoy: quien llegó a los quince en 2019 sigue contando como adolescente, y es lo que hace comparables diez años de gente.`;
const pirCap = (pir.adoTotal
  ? `Adolescentes, 17 años o menos al llegar: ${pir.adoTotal} en total, ${pir.adoM} ${pir.adoM === 1 ? 'mujer' : 'mujeres'} y ${pir.adoH} ${pir.adoH === 1 ? 'hombre' : 'hombres'}. `
  : 'No hay adolescentes en el retrato. ') +
  `La figura dibuja ${pir.dentro} personas de las ${pir.personasTotal} que sostienen un proceso de tres sesiones o más. Las otras ${pir.fuera} no aparecen porque falta su género o su año de nacimiento: es un hueco de captura, no un rasgo, y por eso se cuenta aquí en vez de dibujarse como si fuera un grupo.` +
  // Sin esta frase los números del pie no cuadran: dibujadas + sin clasificar
  // se quedaba corto justo en las que la supresión de celda chica quitó.
  (pir.suprimidas > 0
    ? ` ${pir.suprimidas} más caen en un cruce de edad y género con menos de cinco personas: se omiten del dibujo para no señalar a nadie.`
    : '');

const durNota = 'Cada renglón es la mediana de su grupo en los dos ejes con que se mide un proceso: días de calendario entre la primera y la última sesión, y número de sesiones. La mediana y no el promedio, porque unos pocos procesos de años arrastrarían la media muy por encima de lo que le pasa a la mayoría. Aquí se cuentan PROCESOS y no personas —un proceso de pareja es uno solo, y se clasifica por quien abrió la ficha—, así que estos totales no cuadran con los de la pirámide de arriba, que cuenta a las dos personas por separado.';
const durCap = `Sobre ${dur.n_base3_total} procesos de tres sesiones o más. Los grupos de menos de diez personas se pintan más pálidos: la barra sigue midiendo lo que mide, pero una mediana de cinco casos no sostiene una conclusión.` +
  (dur.procesos_suprimidos > 0
    ? ` ${dur.procesos_suprimidos} ${dur.procesos_suprimidos === 1 ? 'proceso queda' : 'procesos quedan'} fuera de estas tres tablas por caer en un grupo de menos de cinco: una mediana sobre tan pocos casos identificaría casi a la persona.`
    : '');

const bloques = [
  { h3: 'Por género', grupos: dur.por_genero },
  { h3: 'Por edad al llegar', grupos: dur.por_edad },
  { h3: 'Por tipo de proceso', grupos: dur.por_tipo_proceso },
].filter((bl) => bl.grupos.length);

function maxDias(grupos: { mediana_dias: number | null }[]): number {
  return Math.max(1, ...grupos.map((g) => g.mediana_dias ?? 0));
}
---

<Base
  title="Diez años en números | InEssentia"
  description={`Diez años de consulta, en cifras: ${h.personas} personas atendidas, ${h.sesiones} sesiones acompañadas. Cuánto duran los procesos, cuándo y dónde ocurren, y quién llega.`}
  altPath="/ten-years/"
>
  <!-- HERO -->
  <header class="page-header--soft zone-dark">
    <div class="container">
      <p class="label-section label-section--plain" data-reveal>Estadística · {h.primerAnio} – {h.corteAnio}</p>
      <h1 data-reveal style="max-width:20ch;">Diez años de consultas</h1>
      <div class="rprt-kpi" data-reveal>
        <div class="card on-light"><b>{h.personas}</b><span>personas atendidas</span></div>
        <div class="card on-light"><b>{h.sesiones}</b><span>sesiones acompañadas</span></div>
        <div class="card on-light"><b>{h.anios}</b><span>años de práctica ({h.primerAnio}–{h.corteAnio})</span></div>
        <div class="card on-light"><b>{h.enCursoHoy}</b><span>en curso hoy — con sesión en los últimos dos meses</span></div>
      </div>
    </div>
  </header>

  <!-- 01 · CUÁNTO DURAN LOS PROCESOS -->
  <section class="section zone-dark">
    <div class="container">
      <p class="label-section" data-reveal>01 · Los procesos</p>
      <h2 class="heading-section" data-reveal>Cuánto duran los procesos</h2>
      <p class="body-text rprt-measure" data-reveal>{bandasTxt}</p>
      <div class="bandas" data-reveal>
        {BANDAS_ORDEN.map((id) => {
          const banda = b.lista.find((x) => x.id === id);
          const meta = BANDA_META[id];
          if (!banda) return null;
          const pct = banda.pct;
          return (
            <div class="banda card on-light" style={`border-top-color:${BANDAS_COLOR[id]}`}>
              <div class="b-n">{banda.n}</div>
              <div class="b-pct">{pct}% de las personas</div>
              <div class="b-lbl">{meta.lbl}</div>
              <div class="b-rango">{meta.rango}</div>
              <div class="b-desc">{meta.desc}</div>
              {banda.n_mediana > 0 && (
                <div class="b-rango" style="margin-top:6px;color:var(--purple);">
                  Suele abarcar {duracionCorta(banda.mediana_dias, locale)}
                </div>
              )}
            </div>
          );
        })}
      </div>
      <div class="bandas-bar-panel card on-light" data-reveal>
        <div class="bandas-bar">
          {BANDAS_ORDEN.map((id) => {
            const banda = b.lista.find((x) => x.id === id);
            const meta = BANDA_META[id];
            if (!banda) return null;
            return (
              <i
                style={`width:${((100 * banda.n) / (b.total || 1)).toFixed(1)}%;background:${BANDAS_COLOR[id]}`}
                title={`${meta.lbl} (${meta.rango}) · ${banda.n}`}
              />
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · CUÁNDO -->
  <section class="section zone-dark">
    <div class="container">
      <p class="label-section" data-reveal>02 · Cuándo</p>
      <h2 class="heading-section" style="margin-bottom:24px" data-reveal>Cuándo se toman más sesiones</h2>

      <div class="anio-panel card on-light" data-reveal>
        <div class="anio-bars">
          {m.conteo.map((n, i) => (
            <div>
              <i
                style={`height:${Math.round((96 * n) / m.maxS)}px;background:${m.llenos.includes(i) ? 'var(--purple)' : m.flacos.includes(i) ? 'var(--sand-d)' : 'rgba(70,39,110,.28)'}`}
                title={`${MESES[i]} · ${n} sesiones`}
              />
            </div>
          ))}
        </div>
        <div class="anio-axis">
          {m.conteo.map((n, i) => (
            <div>
              <div class="anio-m" style={m.flacos.includes(i) ? 'color:var(--bronze)' : 'color:var(--ink)'}>{MESES[i]}</div>
              <div class="anio-s">{n}</div>
            </div>
          ))}
        </div>
        <div class="anio-leyenda">
          <span><i style="background:var(--purple)"/>Los tres meses de más sesiones</span>
          <span><i style="background:rgba(70,39,110,.28)"/>Resto del año</span>
          <span><i style="background:var(--sand-d)"/>Los tres de menos</span>
        </div>
        <div class="anio-kpis">
          <div><div class="anio-kpi-l">Meses llenos</div><div class="anio-kpi-v">{llenosLbl}</div></div>
          <div><div class="anio-kpi-l">Meses flacos</div><div class="anio-kpi-v" style="color:var(--bronze)">{flacosLbl}</div></div>
        </div>
        <p class="anio-nota">{anioTxt}</p>
      </div>

      <div class="sub-sep">
        <p class="body-text rprt-measure" data-reveal>{horTxt}</p>
        <div class="hor-panel card on-light" data-reveal>
          <div class="hor-wrap">
            <div id="horGrid">
              <div></div>
              {DIAS.map((d) => <div class="hor-cell hor-head">{d}</div>)}
              {Array.from({ length: hor.hMax - hor.hMin + 1 }, (_, k) => hor.hMin + k).map((hh) => (
                <>
                  <div class="hor-cell hor-hour">{hh}:00</div>
                  {Array.from({ length: 7 }, (_, wd) => {
                    const n = hor.grid[wd][hh];
                    const alpha = n > 0 ? (0.08 + (0.82 * Math.sqrt(n)) / Math.sqrt(hor.max)).toFixed(3) : null;
                    return (
                      <div
                        class={`hor-cell hor-day${n > 0 ? '' : ' hor-empty'}`}
                        style={n > 0 ? `background:rgba(70,39,110,${alpha})` : undefined}
                        title={`${DIAS[wd]} ${hh}:00 — ${n} ${n === 1 ? 'sesión' : 'sesiones'}`}
                      />
                    );
                  })}
                </>
              ))}
            </div>
          </div>
          <p class="hor-foot">{horFoot}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · DÓNDE -->
  <section class="section zone-dark zone-dark--warm">
    <div class="container">
      <p class="label-section" data-reveal>03 · Dónde</p>
      <h2 class="heading-section" data-reveal>Online y presencial</h2>
      <p class="body-text rprt-measure" data-reveal>{modTxt}</p>
      <div class="modpp-bar" data-reveal>
        <i style={`width:${mod.pctPresencial}%;background:rgba(255,255,255,.5)`} title={`Presencial · ${mod.presencial}`} />
        <i style={`width:${mod.pctOnline}%;background:var(--sand)`} title={`Online · ${mod.online}`} />
        <i style={`width:${mod.pctHibrido}%;background:var(--wine)`} title={`Híbrido · ${mod.hibrido}`} />
      </div>
      <div class="modpp-leg">
        <span><i style="background:rgba(255,255,255,.5)"/>Presencial · {mod.presencial} ({mod.pctPresencial}%)</span>
        <span><i style="background:var(--sand)"/>Online · {mod.online} ({mod.pctOnline}%)</span>
        <span><i style="background:var(--wine)"/>Híbrido · {mod.hibrido} ({mod.pctHibrido}%)</span>
      </div>
    </div>
  </section>

  <!-- 04 · QUIÉNES -->
  <section class="section zone-dark zone-dark--warm">
    <div class="container">
      <p class="label-section" data-reveal>04 · Quiénes</p>
      <h2 class="heading-section" style="margin-bottom:8px" data-reveal>Quién llega, con qué edad, y cuánto se queda</h2>
      <p class="body-text rprt-measure" data-reveal>{pirTxt}</p>
      <div class="pir-panel card on-light" data-reveal>
        <div class="pir">
          <div class="pir-head">
            <span class="ph-l">Mujeres</span><span class="ph-c">Edad al llegar</span><span class="ph-r">Hombres</span>
          </div>
          {pir.filas.map((f) => (
            <div class={`pir-row${f.tramo === '17 o menos' ? ' pir-ado' : ''}`} title={`${f.tramo} · ${f.mujer} mujeres, ${f.hombre} hombres`}>
              <div class="pir-side pir-l">
                <i style={`width:${f.mujer ? Math.max(2, Math.round((100 * f.mujer) / pir.max)) : 0}%`} />
                <b>{f.mujer ? f.mujer : ''}</b>
              </div>
              <div class="pir-lbl">{f.tramo}</div>
              <div class="pir-side pir-r">
                <b>{f.hombre ? f.hombre : ''}</b>
                <i style={`width:${f.hombre ? Math.max(2, Math.round((100 * f.hombre) / pir.max)) : 0}%`} />
              </div>
            </div>
          ))}
        </div>
        <p class="quien-cap">{pirCap}</p>
      </div>

      <!-- 04b · CUÁNTO DURAN, SEGÚN QUIÉN — vuelve a ser parte de "04", no
           una sección aparte. Estuvo partida en dos porque con las paradas
           viejas el degradado ya había aclarado a arena aquí y el bloque
           necesitaba texto oscuro (zone-light) mientras el resto de "04"
           seguía en claro; el corte era para esquivar la franja, no una
           decisión de contenido. Con el cruce en 79→84 la sección entera
           cae del lado oscuro: medido, el último texto de "04" sobre lienzo
           termina en 59.2% (1280px) / 62.2% (375px). Lo que sí se conserva
           es lo que de verdad daba el contraste: los dos paneles siguen
           siendo .card.on-light, o sea superficie blanca fija, y los pies
           de figura viven DENTRO de ellos. -->
      <div class="dur-panel card on-light" data-reveal>
      <h3 class="heading-section" style="font-size:var(--fs-h4);margin:0 0 4px;">Cuánto duran los procesos, según quién</h3>
      <p class="rprt-nota-chica">{durNota}</p>
      <div id="durPanel">
        {bloques.map((bl) => {
          const max = maxDias(bl.grupos);
          return (
            <div class="dur-bloque">
              <p class="quien-h3">{bl.h3}</p>
              <div class="dur-fila dur-head">
                <span></span><span style="text-align:right">Duración mediana</span>
                <span style="text-align:right">Días</span><span style="text-align:right">Sesiones</span><span style="text-align:right">Personas</span>
              </div>
              {bl.grupos.map((g) => (
                <div class="dur-fila" title={`${g.lbl} · ${g.n} ${g.n === 1 ? 'persona' : 'personas'} · mediana ${g.mediana_dias} días y ${g.mediana_sesiones} sesiones`}>
                  <span class="dur-lbl">{g.lbl}</span>
                  <span class="dur-track"><i style={`width:${Math.max(1, Math.round((100 * (g.mediana_dias ?? 0)) / max))}%;opacity:${g.n < 10 ? '.42' : '1'}`} /></span>
                  <span class="dur-dias">{g.mediana_dias} d</span>
                  <span class="dur-ses">{g.mediana_sesiones}</span>
                  <span class="dur-n">n = {g.n}</span>
                </div>
              ))}
            </div>
          );
        })}
      </div>
      <p class="quien-cap">{durCap}</p>
      </div>
    </div>
  </section>

  <!-- CIERRE · CTA -->
  <section class="section zone-light">
    <div class="container">
      <div class="rprt-cta" data-reveal>
        <p class="body-text" style="margin:0 0 22px;">Cada proceso empieza con una conversación.</p>
        <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--primary">
          Agenda tu primera cita<span class="btn__dot"></span>
        </a>
      </div>

      <p class="rprt-next">
        Corte de datos: {corte}. {exc.procesos_menos_de_3_sesiones} procesos de una o dos sesiones quedan fuera de las
        figuras de modalidad, edad/género y duración por grupo (se cuentan arriba, en la banda «Trabajo inicial»).
      </p>
    </div>
  </section>
</Base>

<style>
  /* Esta página es un reporte de datos: sus tarjetas (KPI, bandas, paneles de
     gráficas, bloques de duración) son islas de papel de fondo claro fijo
     (.on-light) flotando sobre el lienzo continuo del sitio — así los
     números en tinta/morado/vino de las gráficas (calibrados para un fondo
     claro) siguen leyéndose igual sin importar en qué tramo del degradado
     caiga la sección ni qué tema tenga el sitio. Ver CLAUDE.md: ".on-light"
     es justo la clase pensada para fragmentos, no para páginas enteras —
     aquí se usa como se pretende: por tarjeta, no por página. */

  .page-header--soft h1 {
    letter-spacing: -.015em;
  }

  .rprt-measure { max-width: 70ch; }
  .rprt-nota-chica { margin: 0 0 14px; max-width: 62ch; font: 400 12.5px/1.6 var(--ff-body); color: var(--on-canvas-faint); }

  .rprt-kpi {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px; margin-top: 30px;
  }
  .rprt-kpi > .card { padding: 22px 16px; }
  .rprt-kpi b {
    display: block; font-family: var(--ff-head); font-weight: 700;
    font-size: clamp(26px, 4vw, 34px); color: var(--purple); line-height: 1;
  }
  .rprt-kpi span { display: block; margin-top: 8px; font: 400 12.5px/1.45 var(--ff-body); color: var(--text-muted); }

  .bandas { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 6px; }
  .banda { border-top: 4px solid var(--border-card); padding: 18px 20px 20px; }
  .banda .b-n { font-family: var(--ff-head); font-weight: 700; font-size: 34px; line-height: 1; color: var(--purple); }
  .banda .b-pct { font: 700 12.5px var(--ff-body); color: var(--wine); margin-top: 6px; }
  .banda .b-lbl { font: 700 11px var(--ff-body); letter-spacing: .12em; text-transform: uppercase; color: var(--ink); margin-top: 10px; }
  .banda .b-rango { font: 400 11.5px var(--ff-body); color: var(--text-muted); margin-top: 3px; }
  .banda .b-desc { font: 400 12px/1.55 var(--ff-body); color: var(--text-muted); margin-top: 8px; }

  .bandas-bar-panel { padding: 22px 26px; margin-top: 26px; }
  .bandas-bar { display: flex; height: 16px; border-radius: 999px; overflow: hidden; background: rgba(70, 39, 110, .06); }
  .bandas-bar > i { display: block; }

  .anio-panel { padding: 26px 28px 24px; margin-top: 6px; }
  .anio-bars { display: flex; gap: 12px; align-items: flex-end; height: 96px; }
  .anio-bars > div { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }
  .anio-bars i { display: block; width: 100%; border-radius: 4px 4px 0 0; }
  .anio-axis { display: flex; gap: 12px; margin-top: 9px; border-top: 1px solid var(--purple); padding-top: 9px; }
  .anio-axis > div { flex: 1; text-align: center; }
  .anio-m { font: 700 12px var(--ff-body); }
  .anio-s { font: 400 11px var(--ff-body); color: var(--text-muted); margin-top: 2px; }
  .anio-kpis {
    display: flex; gap: 44px; margin-top: 26px; flex-wrap: wrap;
    border-top: 1px solid var(--border-card); padding-top: 22px;
  }
  .anio-kpis > div { min-width: 200px; }
  .anio-kpi-l { font: 700 11px var(--ff-body); letter-spacing: .13em; text-transform: uppercase; color: var(--text-muted); }
  .anio-kpi-v { font-family: var(--ff-head); font-weight: 700; font-size: 20px; color: var(--purple); margin-top: 6px; }
  .anio-nota { margin: 20px 0 0; font: 400 12px var(--ff-body); color: var(--text-muted); }
  .anio-leyenda { display: flex; gap: 20px; margin-top: 16px; flex-wrap: wrap; }
  .anio-leyenda span { display: flex; gap: 7px; align-items: center; font: 400 12px var(--ff-body); color: var(--text); }
  .anio-leyenda i { width: 11px; height: 11px; border-radius: 2px; display: block; }

  .modpp-bar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; background: rgba(255, 255, 255, .1); margin-top: 14px; }
  .modpp-bar > i { display: block; }
  .modpp-leg { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 12px; font: 400 12px var(--ff-body); color: var(--on-canvas-soft); }
  .modpp-leg span { display: flex; gap: 7px; align-items: center; }
  .modpp-leg i { width: 11px; height: 11px; border-radius: 2px; display: block; }

  .hor-panel { padding: 24px 26px 22px; }
