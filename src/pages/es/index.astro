---
import Base from '../../layouts/Base.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Img from '../../components/Img.astro';
import BlogCard from '../../components/BlogCard.astro';
import { t } from '../../i18n/utils';
import { businessSchema, personSchema } from '../../data/person';

interface Props {
  canonical?: string;
}

const { canonical } = Astro.props;

const locale = 'es';
const i = t(locale);

const schema = businessSchema(locale, i.site.description);
const authorSchema = personSchema(locale);
---

<Base title={i.site.title} description={i.site.description} canonical={canonical} altPath="/" ogImage="/uploads/og/home-es.webp" schema={schema} extraSchemas={[authorSchema]} nav="photo">

  <!-- HERO -->
  <SiteHeader
    variant="cinema"
    eyebrow={i.hero.label}
    title={i.hero.title}
    photo="/uploads/hero-crops/patricio-ruiz-retrato-hero-movil.webp"
    photoDesktop="/uploads/hero-crops/patricio-ruiz-retrato-hero-cinema.webp"
    photoAlt="Retrato de Patricio Ruiz, terapeuta, persona adulta joven de tez media y cabello oscuro sentada con semblante apacible y mirada cálida"
    ctaLabel={i.hero.cta}
    ctaHref="https://wa.me/patriciomx"
    secondaryLabel={i.hero.secondary}
    secondaryHref="/es/sobre-mi/#formacion"
  >
    <p>{i.hero.subtitle}</p>
  </SiteHeader>

  <!-- APPROACH -->
  <section class="section zone-dark">
    <div class="container--narrow">
      <div class="section-header">
        <p data-reveal class="label-section">{i.approach.label}</p>
        <h2 data-reveal class="heading-section" style="margin:0;max-width:24ch;letter-spacing:-.01em;color:var(--heading-canvas);">{i.approach.title}</h2>
      </div>
      <p data-reveal class="body-text" style="margin:0 0 22px;max-width:62ch;color:var(--on-canvas);">{i.approach.p1}</p>
      <p data-reveal class="body-text" style="margin:0 0 34px;max-width:62ch;color:var(--on-canvas);">{i.approach.p2}</p>
      <a data-reveal href="/es/blog/tipos-de-terapia/" class="link-underline">{i.approach.link}</a>
    </div>
  </section>

  <!-- MODALITIES -->
  <section id="modalidades" class="section section--cream zone-dark">
    <div class="container">
      <div class="section-header">
        <p data-reveal class="label-section">{i.modalities.label}</p>
        <h2 data-reveal class="heading-section" style="color:var(--heading-canvas);">{i.modalities.title}</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:26px;" class="modal-grid">

        <div data-reveal class="card" style="padding:38px 32px;display:flex;flex-direction:column;gap:18px;">
          <a href="/es/terapia/individual/" style="display:contents;text-decoration:none;">
            <div class="icon-disc">
              <Img src="/uploads/icono-terapia-individual.webp" alt="" sizes="96px" style="height:78px;width:auto;display:block;" />
            </div>
            <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:26px;margin:0;">{i.modalities.individual.title}</h3>
          </a>
          <p style="font-size:16px;line-height:1.65;color:var(--on-canvas-soft);margin:0;flex:1;">{i.modalities.individual.desc}</p>
          <a href="/es/terapia/individual/" style="color:var(--heading-canvas);font-weight:700;font-size:14px;letter-spacing:.04em;text-decoration:none;align-self:flex-start;">{i.modalities.individual.link}</a>
        </div>

        <div data-reveal class="card" style="padding:38px 32px;display:flex;flex-direction:column;gap:18px;">
          <a href="/es/terapia/pareja/" style="display:contents;text-decoration:none;">
            <div class="icon-disc">
              <Img src="/uploads/icono-terapia-pareja.webp" alt="" sizes="96px" style="height:96px;width:auto;display:block;" />
            </div>
            <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:26px;margin:0;">{i.modalities.couples.title}</h3>
          </a>
          <p style="font-size:16px;line-height:1.65;color:var(--on-canvas-soft);margin:0;flex:1;">{i.modalities.couples.desc}</p>
          <a href="/es/terapia/pareja/" style="color:var(--heading-canvas);font-weight:700;font-size:14px;letter-spacing:.04em;text-decoration:none;align-self:flex-start;">{i.modalities.couples.link}</a>
        </div>

        <div data-reveal class="card" style="padding:38px 32px;display:flex;flex-direction:column;gap:18px;">
          <a href="/es/terapia/familias/" style="display:contents;text-decoration:none;">
            <div class="icon-disc">
              <Img src="/uploads/icono-terapia-familiar.webp" alt="" sizes="96px" style="height:88px;width:auto;display:block;" />
            </div>
            <h3 style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:26px;margin:0;">{i.modalities.family.title}</h3>
          </a>
          <p style="font-size:16px;line-height:1.65;color:var(--on-canvas-soft);margin:0;flex:1;">{i.modalities.family.desc}</p>
          <a href="/es/terapia/familias/" style="color:var(--heading-canvas);font-weight:700;font-size:14px;letter-spacing:.04em;text-decoration:none;align-self:flex-start;">{i.modalities.family.link}</a>
        </div>

      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <TestimonialCarousel locale={locale} />

  <!-- PODCAST -->
  <section class="zone-dark zone-dark--warm" style="background:transparent;padding:clamp(56px,8vw,100px) 32px;overflow:hidden;position:relative;">
    <div class="container">
      <div style="position:relative;max-width:820px;display:flex;gap:clamp(32px,5vw,64px);align-items:center;flex-wrap:wrap;">
        <div style="flex:1 1 320px;">
          <p data-reveal class="label-section">{i.podcast.label}</p>
          <h2 data-reveal style="font-family:'Bitter',serif;font-weight:700;color:var(--heading-canvas);font-size:clamp(26px,3.8vw,42px);line-height:1.1;margin:0 0 16px;text-wrap:balance;">{i.podcast.title}</h2>
          <p data-reveal style="font-size:clamp(15px,1.1vw,17px);line-height:1.65;color:var(--on-canvas-soft);margin:0;">{i.podcast.desc}</p>
        </div>
        <div data-reveal style="flex:1 1 280px;">
          <form id="podcast-form" class="on-dark" action="https://formspree.io/f/mzdqnrka" method="POST" style="background:var(--surface);border:1px solid var(--border-card);border-radius:18px;padding:28px 26px;display:flex;flex-direction:column;gap:14px;">
            <input type="hidden" name="_subject" value="Solicitud de podcast — inessentia.mx">
            <label for="podcast-nombre" style="font-size:13px;color:var(--on-canvas-soft);font-weight:700;letter-spacing:.02em;">{i.podcast.nameLabel}</label>
            <input id="podcast-nombre" type="text" name="nombre" placeholder={i.podcast.namePlaceholder} required class="form-input">
            <label for="podcast-email" style="font-size:13px;color:var(--on-canvas-soft);font-weight:700;letter-spacing:.02em;">{i.podcast.emailLabel}</label>
            <input id="podcast-email" type="email" name="email" placeholder={i.podcast.emailPlaceholder} required class="form-input">
            <button type="submit" class="btn btn--secondary" style="align-self:flex-start;width:auto;">{i.podcast.submit}</button>
            <p id="podcast-error" class="form-msg err" role="alert" style="display:none;">Tuvimos un error, puedes escribirnos a <a href="mailto:patricio@inessentia.mx" class="link-inline">patricio@inessentia.mx</a> para solicitar el podcast o notificarnos.</p>
            <p style="margin:0;font-size:12px;color:var(--text-faint);line-height:1.5;">{i.podcast.privacy} <a href={`/${locale}/privacidad/`} style="color:var(--text-muted);font-weight:700;text-decoration:none;">{i.podcast.privacyLink}</a>.</p>
          </form>
          <div id="podcast-thanks" class="on-dark" style="display:none;background:var(--surface);border:1px solid var(--border-card);border-radius:18px;padding:28px 26px;">
            <p style="font-size:32px;margin:0 0 12px;">{i.podcast.thanksEmoji}</p>
            <p style="font-family:'Bitter',serif;font-size:22px;color:var(--heading);font-weight:700;margin:0 0 10px;">{i.podcast.thanksTitle}</p>
            <a href="https://speechify.app.link/JKr46qR953b" target="_blank" rel="noopener" class="btn btn--secondary" style="padding:13px 26px;margin-top:6px;width:auto;">{i.podcast.thanksCta}</a>
            <p style="font-size:13px;color:var(--text-faint);margin:14px 0 0;">{i.podcast.thanksNote}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
  (function() {
    var form = document.getElementById('podcast-form');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      var btn = form.querySelector('button[type="submit"]');
      var errMsg = document.getElementById('podcast-error');
      var originalText = btn ? btn.textContent : '';
      if (errMsg) errMsg.style.display = 'none';
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }
      fetch('https://formspree.io/f/mzdqnrka', {
        method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' }
      }).then(function(r) {
        if (!r.ok) throw new Error();
        form.style.display = 'none';
        var thanks = document.getElementById('podcast-thanks');
        if (thanks) thanks.style.display = 'block';
      }).catch(function() {
        if (btn) { btn.disabled = false; btn.textContent = originalText; }
        if (errMsg) errMsg.style.display = 'block';
      });
    });
  })();
  </script>

  <!-- BLOG -->
  <section class="section section--cream zone-dark zone-dark--warm">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:clamp(36px,4vw,56px);">
        <div data-reveal>
          <p class="label-section">{i.blog.label}</p>
          <h2 class="heading-section" style="color:var(--heading-canvas);">{i.blog.title}</h2>
        </div>
        <a data-reveal href="/es/recursos/" class="link-underline">{i.blog.seeAll}</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:26px;" class="blog-grid">

        <BlogCard
          href="/es/blog/que-esperar-de-la-terapia/"
          image="/uploads/que-esperar-terapia.webp"
          imageAlt="Retrato de una mujer joven de tez media con mirada cálida sosteniendo un corazón y mostrándoselo a la cámara"
          imagePosition="center 20%"
          title="¿Qué esperar de la terapia?"
          excerpt="Cómo se conjugan la relación terapéutica, los abordajes y el tiempo en un proceso real."
          readMoreLabel={i.blog.readMore}
        />

        <BlogCard
          href="/es/blog/primera-cita/"
          image="/uploads/primera-cita-terapia.webp"
          imageAlt="Sala de terapia vacía con dos sillones uno frente al otro, luz cálida de tarde"
          imagePosition="center 30%"
          title="¿Cómo suele ser la primera cita?"
          excerpt="Cuando me contactas por primera vez, así arrancamos: qué pasa, cuánto dura, qué llevarte."
          readMoreLabel={i.blog.readMore}
        />

        <BlogCard
          href="/es/blog/cuando-es-buen-momento/"
          image="/uploads/buen-momento-pareja.webp"
          imageAlt="Persona sentada junto a una ventana en la mañana sosteniendo una taza, ambiente contemplativo"
          imagePosition="center 55%"
          title="¿Cuándo es buen momento para empezar terapia?"
          excerpt="Las señales que vale la pena escuchar — y por qué pedir ayuda no requiere tocar fondo."
          readMoreLabel={i.blog.readMore}
        />

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="zone-light" style="position:relative;overflow:hidden;background:transparent;padding:clamp(64px,9vw,118px) 32px;">
    <div class="container">
      <div data-reveal style="position:relative;max-width:760px;">
        <h2 class="heading-section" style="margin:0 0 22px;text-wrap:balance;color:var(--heading-canvas);">{i.cta.title}</h2>
        <p class="body-text" style="margin:0 0 36px;max-width:52ch;color:var(--on-canvas);">{i.cta.desc}</p>
        <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" class="btn btn--secondary">{i.cta.button}</a>
      </div>
    </div>
  </section>

</Base>
