---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import Footer from '../components/Footer.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import ParallaxImages from '../components/ParallaxImages.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLocale, t } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  altPath?: string; // path in the OTHER locale (e.g. /about-me/ when current is /es/sobre-mi/)
  schema?: object;
  extraSchemas?: object[];
  hideFooter?: boolean;
  noindex?: boolean;
  // Navbar background variant: 'gradient' (default, cristal translúcido
  // adaptado al scroll), 'photo' (igual que gradient, pero conserva una
  // regla propia para el color de la hamburguesa con el menú abierto sobre
  // fotos), 'dark' (solid --purple siempre, para páginas que continúan en su
  // propia UI oscura debajo, e.g. Red Inessentia's map app). Las variantes
  // 'light' y 'solid' existieron antes pero sus clases CSS nunca se
  // implementaron: se quitaron del tipo.
  nav?: 'gradient' | 'photo' | 'dark';
  hideNav?: boolean;
  noAltLocale?: boolean;
}

const locale = getLocale(Astro.url);
const i = t(locale);
const altLocale = locale === 'es' ? 'en' : 'es';

const {
  title = i.site.title,
  description = i.site.description,
  canonical = Astro.url.href,
  ogImage = '/uploads/og/default.webp',
  altPath,
  schema,
  extraSchemas,
  hideFooter = false,
  noindex = false,
  nav = 'gradient',
  hideNav = false,
  noAltLocale = false,
} = Astro.props;

const altHref = altPath
  ? `/${altLocale}${altPath}`
  : `/${altLocale}/`;
const altHrefAbsolute = `https://inessentia.mx${altHref}`;
const currentHref = `https://inessentia.mx${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Tema: OSCURO por defecto, adaptable al dispositivo (si prefiere claro),
       preferencia guardada gana. Se resuelve antes del render para evitar parpadeo. -->
  <script is:inline>
    (function(){
      try{
        var saved=localStorage.getItem('iness-theme');
        var theme=saved||(window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');
        document.documentElement.setAttribute('data-theme',theme);
      }catch(e){ document.documentElement.setAttribute('data-theme','dark'); }
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="canonical" href={canonical}>
  {!noAltLocale && <link rel="alternate" hreflang={locale} href={currentHref}>}
  {!noAltLocale && <link rel="alternate" hreflang={altLocale} href={altHrefAbsolute}>}
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={currentHref}>
  <meta property="og:image" content={`https://inessentia.mx${ogImage}`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/webp">
  <meta property="og:image:alt" content={title}>
  <meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'}>
  <meta property="og:site_name" content="Inessentia">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`https://inessentia.mx${ogImage}`}>
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
  {extraSchemas && extraSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <!-- Fuentes auto-hospedadas (ver @font-face en global.css). Precarga de las
       críticas para el primer render; el resto se resuelve por @font-face. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/mulish-var.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/bitter-var.woff2" crossorigin>
  <!-- GA se carga incondicional más abajo (ver <body>): el banner de
       CookieConsent está pausado, así que ya no hay gate de consentimiento. -->
</head>
<body>
  {!hideNav && <Navbar locale={locale} variant={nav} />}
  {!hideNav && <MobileMenu locale={locale} />}
  {!hideNav && <MenuOverlay locale={locale} />}
  <main>
    <slot />
  </main>
  {!hideFooter && <Footer locale={locale} />}
  {/* Pausado temporalmente a pedido del usuario — el componente y su lógica
      de localStorage/GA siguen intactos, solo se dejó de montar. */}
  {/* <CookieConsent locale={locale} /> */}
  {/* El banner de cookies sigue pausado (arriba), pero Analytics debe seguir
      corriendo: como loadGA() vivía DENTRO de CookieConsent.astro, al no
      montar ese componente GA dejó de cargar por completo. Este bloque carga
      GA de forma incondicional, sin esperar consentimiento. Si algún día se
      vuelve a montar <CookieConsent />, HAY QUE QUITAR este script: si se
      deja, GA cargaría antes del consentimiento y el banner quedaría de
      adorno. */}
  <script is:inline>
    (function() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-LWCY1M4Y9T';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LWCY1M4Y9T');
    })();
  </script>
  <RevealOnScroll />
  <ParallaxImages />
  {/* El toggle de tema ya no flota aparte — vive dentro de los menús de
      navegación (MobileMenu.astro y MenuOverlay.astro, cada uno con su
      propio [data-theme-toggle]; solo uno es visible a la vez según el
      breakpoint). La lógica se queda acá, centralizada, y engancha a
      TODAS las instancias del botón que haya en el DOM. */}
  <script is:inline>
    (function(){
      var KEY='iness-theme';
      var saved=localStorage.getItem(KEY);
      if(saved){document.documentElement.setAttribute('data-theme',saved);}
      document.querySelectorAll('[data-theme-toggle]').forEach(function(b){
        b.addEventListener('click',function(){
          var next=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';
          document.documentElement.setAttribute('data-theme',next);
          localStorage.setItem(KEY,next);
        });
      });
    })();
  </script>
  <script>
    import '../scripts/video-embed.js';
  </script>
</body>
</html>
