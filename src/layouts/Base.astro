---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import Footer from '../components/Footer.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import ParallaxImages from '../components/ParallaxImages.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLocale, t } from '../i18n/utils';
import { resolveAsset } from '../lib/resolve-asset';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  altPath?: string; // path in the OTHER locale (e.g. /about-me/ when current is /es/sobre-mi/)
  schema?: object;
  extraSchemas?: object[];
  hideFooter?: boolean;
  /* Ver Footer.astro y .canvas-landing (global.css): sólo para páginas cortas,
     donde el footer cae antes de que el lienzo amanezca. */
  footerLanding?: 'fade' | 'cont';
  noindex?: boolean;
  // Navbar background variant: 'gradient' (default, cristal translúcido
  // adaptado al scroll), 'photo' (igual que gradient, pero conserva una
  // regla propia para el color de la hamburguesa con el menú abierto sobre
  // fotos), 'dark' (solid --purple siempre, para páginas que continúan en su
  // propia UI oscura debajo, e.g. Red Inessentia's map app). Las variantes
  // 'light' y 'solid' existieron antes pero sus clases CSS nunca se
  // implementaron: se quitaron del tipo.
  nav?: 'gradient' | 'photo' | 'dark';
  hideNav?: boolean;
  noAltLocale?: boolean;
}

const locale = getLocale(Astro.url);
const i = t(locale);
const altLocale = locale === 'es' ? 'en' : 'es';

const {
  title = i.site.title,
  description = i.site.description,
  canonical = Astro.url.href,
  ogImage = '/uploads/og/default.webp',
  altPath,
  schema,
  extraSchemas,
  hideFooter = false,
  footerLanding,
  noindex = false,
  nav = 'gradient',
  hideNav = false,
  noAltLocale = false,
} = Astro.props;

const altHref = altPath
  ? `/${altLocale}${altPath}`
  : `/${altLocale}/`;
const altHrefAbsolute = `https://inessentia.mx${altHref}`;
const currentHref = `https://inessentia.mx${Astro.url.pathname}`;
// og:image/twitter:image y los <link preload as=font> son atributos crudos
// (no pasan por <Img>): resolverlos aquí es lo que evita que og/*.webp y los
// woff2 queden sirviendo bytes viejos bajo su nombre estable una vez
// hasheados (ver src/lib/resolve-asset.ts).
const ogImageUrl = `https://inessentia.mx${resolveAsset(ogImage)}`;
const mulishFontUrl = resolveAsset('/fonts/mulish-var.woff2');
const bitterFontUrl = resolveAsset('/fonts/bitter-var.woff2');
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Tema: OSCURO FIJO. El modo claro quedó desactivado a pedido del usuario:
       ya no se consulta prefers-color-scheme ni la preferencia guardada
       ('iness-theme'), y el toggle salió de los menús. La capa
       :root[data-theme="light"] de global.css se conserva intacta (queda
       inerte) para poder reactivarlo revirtiendo solo este bloque, el script
       del toggle al final del body y los botones de los menús. -->
  <script is:inline>
    document.documentElement.setAttribute('data-theme','dark');
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="canonical" href={canonical}>
  {!noAltLocale && <link rel="alternate" hreflang={locale} href={currentHref}>}
  {!noAltLocale && <link rel="alternate" hreflang={altLocale} href={altHrefAbsolute}>}
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={currentHref}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/webp">
  <meta property="og:image:alt" content={title}>
  <meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'}>
  <meta property="og:site_name" content="Inessentia">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
  {extraSchemas && extraSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <!-- Fuentes auto-hospedadas (ver @font-face en global.css). Precarga de las
       críticas para el primer render; el resto se resuelve por @font-face. -->
  <link rel="preload" as="font" type="font/woff2" href={mulishFontUrl} crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={bitterFontUrl} crossorigin>
  <!-- GA se carga incondicional más abajo (ver <body>): el banner de
       CookieConsent está pausado, así que ya no hay gate de consentimiento. -->
</head>
<body>
  {!hideNav && <Navbar locale={locale} variant={nav} />}
  {!hideNav && <MobileMenu locale={locale} />}
  {!hideNav && <MenuOverlay locale={locale} />}
  <main>
    <slot />
  </main>
  {!hideFooter && <Footer locale={locale} landing={footerLanding} />}
  {/* Pausado temporalmente a pedido del usuario — el componente y su lógica
      de localStorage/GA siguen intactos, solo se dejó de montar. */}
  {/* <CookieConsent locale={locale} /> */}
  {/* El banner de cookies sigue pausado (arriba), pero Analytics debe seguir
      corriendo: como loadGA() vivía DENTRO de CookieConsent.astro, al no
      montar ese componente GA dejó de cargar por completo. Este bloque carga
      GA sin esperar consentimiento previo, CON UNA EXCEPCIÓN: si el visitante
      ya rechazó explícitamente (localStorage 'cookie-consent' === 'essential',
      la misma clave/valor que usa CookieConsent.astro), este script sale
      temprano y no carga nada. El opt-out se ofrece desde la página de aviso
      de privacidad. Si localStorage está bloqueado, GA carga igual. Si algún
      día se vuelve a montar <CookieConsent />, HAY QUE QUITAR este script: si
      se deja, GA cargaría antes del consentimiento y el banner quedaría de
      adorno. */}
  <script is:inline>
    (function() {
      // Sólo en producción: `npm run dev` (localhost) se estaba contando como
      // tráfico real — la mitad de las vistas de los últimos 90 días eran del
      // propio servidor de desarrollo, no de visitantes.
      var host = location.hostname;
      if (host !== 'inessentia.mx' && host !== 'www.inessentia.mx') return;
      try {
        if (localStorage.getItem('cookie-consent') === 'essential') return;
      } catch (e) { /* localStorage bloqueado: seguimos con el comportamiento por defecto */ }
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-LWCY1M4Y9T';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LWCY1M4Y9T');
    })();
  </script>
  {/* Eventos de conversión. window.inessentiaEvento() es el helper que usan
      los <script> de cada formulario al confirmar un envío exitoso (fetch
      resuelto con éxito, no el submit crudo). El listener de clics es
      delegado en document y no depende de que GA haya cargado: si
      window.gtag no existe (localhost, opt-out) no hace nada y no truena. */}
  <script is:inline>
    (function() {
      window.inessentiaEvento = function(nombre, params) {
        if (typeof window.gtag !== 'function') return;
        window.gtag('event', nombre, params || {});
      };

      function ubicacionDe(a) {
        if (a.closest('#site-nav')) return 'navbar';
        if (a.closest('#menu-overlay')) return 'menu';
        if (a.closest('#mob-menu')) return 'menu_movil';
        if (a.closest('.footer2')) return 'footer';
        return 'cuerpo';
      }

      document.addEventListener('click', function(e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var href = a.href || '';
        var evento = null;
        if (/wa\.me|api\.whatsapp\.com/.test(href)) evento = 'contacto_whatsapp';
        else if (/buy\.stripe\.com|checkout\.stripe\.com/.test(href)) evento = 'pago_stripe';
        if (!evento) return;
        if (typeof window.gtag !== 'function') return;
        var params = { link_url: href, ubicacion: ubicacionDe(a) };
        // target=_blank abre pestaña nueva: no hace falta beacon. En la misma
        // pestaña, sin beacon el evento puede perderse porque la navegación
        // corta la petición antes de que salga.
        if (a.target !== '_blank') params.transport_type = 'beacon';
        window.gtag('event', evento, params);
      });
    })();
  </script>
  <RevealOnScroll />
  <ParallaxImages />
  {/* El toggle de tema vivía acá (enganchaba todos los [data-theme-toggle] de
      MobileMenu.astro y MenuOverlay.astro). Se quitó junto con los botones al
      desactivar el modo claro; el tema se fija en el <head>. */}
  <script>
    import '../scripts/video-embed.js';
  </script>
</body>
</html>
