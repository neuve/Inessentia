<script is:inline>
(function() {
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        e.target.style.transform = 'none';
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });

  function init() {
    var els = document.querySelectorAll('[data-reveal]');
    var vh = window.innerHeight || 800;
    // Lecturas de layout (getBoundingClientRect) separadas de las escrituras
    // (style.transform): intercaladas, cada escritura invalida el layout y
    // fuerza un reflow síncrono en la siguiente lectura del bucle.
    var tops = [];
    els.forEach(function(el) { tops.push(el.getBoundingClientRect().top); });
    els.forEach(function(el, i) {
      if (tops[i] < vh * 0.95) { el.style.transform = 'none'; }
      else { io.observe(el); }
    });
    setTimeout(function() {
      document.querySelectorAll('[data-reveal]').forEach(function(el) {
        el.style.transform = 'none';
      });
    }, 2600);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      requestAnimationFrame(function() { requestAnimationFrame(init); });
    });
  } else {
    requestAnimationFrame(function() { requestAnimationFrame(init); });
  }
})();
</script>
