---
import { t, sitePath, type Locale } from '../i18n/utils';
import pkg from '../../package.json';
import Img from './Img.astro';
import { resolveAsset } from '../lib/resolve-asset';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const i = t(locale);
const currentYear = new Date().getFullYear();
const siteVersion = pkg.version;

const privacyPath = sitePath(locale, 'privacy');
const termsPath = sitePath(locale, 'terms');
const costsPath = sitePath(locale, 'costs');
const resourcesPath = sitePath(locale, 'resources');
const termsLabel = locale === 'es' ? 'Términos de servicio' : 'Terms of service';
const costsLabel = locale === 'es' ? 'Costos' : 'Costs';

const therapyBase = `/${locale}/${locale === 'es' ? 'terapia' : 'therapy'}/`;
const therapyLinks = [
  { label: i.nav.individual, href: `${therapyBase}individual/` },
  { label: i.nav.couples, href: `${therapyBase}${locale === 'es' ? 'pareja' : 'couples'}/` },
  { label: i.nav.family, href: `${therapyBase}${locale === 'es' ? 'familias' : 'family'}/` },
  { label: costsLabel, href: costsPath },
];
const exploreLinks = [
  { label: i.nav.about, href: `/${locale}/${locale === 'es' ? 'sobre-mi' : 'about-me'}/` },
  { label: i.nav.resources, href: resourcesPath },
  { label: i.nav.network, href: `/${locale}/${locale === 'es' ? 'red-terapeutica' : 'therapist-network'}/` },
];
const legalLinks = [
  { label: i.footer.privacy, href: privacyPath },
  { label: termsLabel, href: termsPath },
];
---

<footer class="footer2 zone-light">
  <div class="footer2__inner">

    <div class="footer2__cols">
      <!-- brand -->
      <div>
        <a href={`/${locale}/`} class="footer2__brand">
          <Img src="/uploads/logo-icon.webp" sizes="52px" alt="Logotipo de Patricio Ruiz" class="footer2__logo" />
          <span class="footer2__name">Patricio<br>Ruiz</span>
        </a>
      </div>

      <!-- therapy links -->
      <div>
        <p class="footer2__coltitle">{i.footer.colTherapy}</p>
        <div class="footer2__links">
          {therapyLinks.map(l => (<a href={l.href} class="footer2__link">{l.label}</a>))}
        </div>
      </div>

      <!-- explore links -->
      <div>
        <p class="footer2__coltitle">{i.footer.colExplore}</p>
        <div class="footer2__links">
          {exploreLinks.map(l => (<a href={l.href} class="footer2__link">{l.label}</a>))}
        </div>
      </div>

      <!-- contact -->
      <div>
        <p class="footer2__coltitle">{i.footer.colContact}</p>
        <p class="footer2__contactline">{i.footer.contactLine}</p>
        <a href="mailto:patricio@inessentia.mx" class="footer2__email">patricio@inessentia.mx</a>
        <div class="footer2__social">
          <a href="https://www.instagram.com/neuve" target="_blank" rel="noopener" aria-label="Instagram" class="footer2__soc">
            <img src={resolveAsset('/uploads/instagram-icon.svg')} alt="" width="18" height="18" />
          </a>
          <a href="https://www.facebook.com/neuve0/" target="_blank" rel="noopener" aria-label="Facebook" class="footer2__soc">
            <img src={resolveAsset('/uploads/facebook-icon.png')} alt="" width="18" height="18" />
          </a>
          <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" aria-label="WhatsApp" class="footer2__soc">
            <img src={resolveAsset('/uploads/whatsapp-icon.svg')} alt="" width="18" height="18" />
          </a>
          <a href="https://www.linkedin.com/in/patricioruiz/" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer2__soc">
            <img src={resolveAsset('/uploads/linkedin-icon.png')} alt="" width="18" height="18" />
          </a>
        </div>
      </div>
    </div>

    <!-- emergency strip -->
    <div class="footer2__emergency">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-canvas)" stroke-width="2.2" stroke-linecap="round" style="flex:none;"><circle cx="12" cy="12" r="9"/><line x1="12" y1="7.5" x2="12" y2="13"/><circle cx="12" cy="16.5" r="0.4" fill="var(--accent-canvas)"/></svg>
      <p>{i.footer.emergency}</p>
    </div>

    <!-- bottom bar -->
    <div class="footer2__bottom">
      <p class="footer2__copyright">© 2025–{currentYear} Patricio Ruiz Abrín</p>
      <div class="footer2__bottomright">
        {legalLinks.map(l => (<a href={l.href} class="footer2__legal">{l.label}</a>))}
        <span class="footer2__version">v{siteVersion}</span>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer2 {
    position: relative; overflow: hidden; background: transparent;
    color: var(--on-canvas); padding: clamp(56px,7vw,72px) var(--gutter) 30px;
  }
  .footer2__inner { position: relative; max-width: var(--container-w); margin: 0 auto; }
  .footer2__cols {
    display: grid; grid-template-columns: 1.8fr 1fr 1fr 1.3fr;
    gap: clamp(32px,4vw,52px); align-items: start; padding-bottom: 44px;
  }
  /* Apilado (ícono arriba, nombre abajo) en vez de fila: le da al lockup más
     presencia de marca frente a las columnas de texto plano de al lado, y
     mantiene el mismo margen izquierdo que ellas (nunca centrado). */
  .footer2__brand { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; text-decoration: none; }
  .footer2__logo { height: 72px; width: auto; display: block; }
  .footer2__name { font-family: var(--ff-head); font-weight: 700; color: var(--heading-canvas); font-size: 22px; line-height: 1.15; }
  .footer2__coltitle {
    margin: 0 0 18px; font-weight: 700; font-size: 12px; letter-spacing: 0;
    text-transform: none; color: var(--accent-canvas);
  }
  .footer2__links { display: flex; flex-direction: column; gap: 12px; }
  .footer2__link { font-size: 15px; color: var(--on-canvas-soft); text-decoration: none; transition: color .2s; width: fit-content; }
  .footer2__link:hover { color: var(--accent-canvas); }
  .footer2__contactline { margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: var(--on-canvas-faint); }
  .footer2__email {
    display: inline-block; color: var(--heading-canvas); font-size: 16px; font-weight: 600; text-decoration: none;
    margin-bottom: 20px; transition: color .2s;
  }
  .footer2__email:hover { color: var(--accent-canvas); }
  .footer2__social { display: flex; align-items: center; gap: 12px; }
  .footer2__soc {
    display: flex; align-items: center; justify-content: center; width: 38px; height: 38px;
    border-radius: 50%; background: var(--surface); border: 1px solid var(--border-card);
    transition: background .2s, border-color .2s;
  }
  .footer2__soc:hover { border-color: var(--accent-canvas); }
  /* El footer vive en el tramo claro (zone-light) del lienzo → glifos oscuros sobre crema.
     object-fit:contain es obligatorio: facebook-icon.png (1089×1867) y linkedin-icon.png
     (816×645) NO son cuadrados, y sin él el `fill` por defecto los deformaba dentro del
     hueco de 18×18 (la "f" salía gorda y el "in" estirado a lo alto). */
  .footer2__soc img { width: 18px; height: 18px; display: block; object-fit: contain; filter: brightness(0); }
  /* rgba(142,43,93,.1) = --wine (#8E2B5D) con alpha; rgba(194,176,126,.4) = --sand (#C2B07E) con alpha.
     Escritos a mano porque no hay color-mix() en uso aqui; no dupliques estos valores en otro lado. */
  .footer2__emergency {
    display: flex; align-items: center; gap: 12px; background: rgba(142,43,93,.1);
    border: 1px solid rgba(194,176,126,.4); border-radius: 12px; padding: 14px 20px; margin-bottom: 24px;
  }
  .footer2__emergency p { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--on-canvas-soft); }
  .footer2__bottom {
    border-top: 1px solid var(--border-hair); padding-top: 22px;
    display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap;
  }
  .footer2__copyright { margin: 0; font-size: 13px; color: var(--on-canvas-faint); }
  .footer2__bottomright { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .footer2__legal { font-size: 13px; color: var(--on-canvas-faint); text-decoration: none; transition: color .2s; }
  .footer2__legal:hover { color: var(--accent-canvas); }
  .footer2__version {
    font-size: 12px; color: var(--on-canvas-faint);
    border: 1px solid var(--border-hair); padding: 3px 10px; border-radius: 99px; white-space: nowrap;
  }
  @media (max-width: 900px) {
    .footer2__cols { grid-template-columns: 1fr 1fr; gap: 36px; }
  }
  @media (max-width: 560px) {
    .footer2__cols { grid-template-columns: 1fr 1fr; }
    .footer2__cols > div:first-child { grid-column: 1 / -1; }
    .footer2__bottom { justify-content: flex-start; }
  }
</style>
