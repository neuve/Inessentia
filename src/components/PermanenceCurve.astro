---
// Curva de permanencia: barra de supervivencia (una franja fina por mes,
// altura = % de la serie que seguía activa) coloreada por tramo, con leyenda
// debajo. Vive sobre zone-dark (dentro de <StatsBand>, vía <slot />).
//
// Método: skill "dataviz". Paleta = tokens de marca del sitio (sand → sand-d
// → wine → wine/purple), leídos como una rampa ORDINAL (las 4 categorías son
// etapas ordenadas de permanencia, no identidades arbitrarias) en vez de una
// paleta categórica de 4 tonos libres — es la lectura correcta para "cuánto
// más dura el proceso, más profundo el tono", y es lo único que el validador
// del skill deja pasar sin inventar hex fuera de los tokens de marca (ver
// nota de desviación en la respuesta final). Cada franja lleva su propio
// title="" como tooltip nativo (sin JS) y la leyenda siempre presente hace de
// canal de identidad dependable, tal como pide el skill para ≥2 series.

interface LegendItem {
  name: string;
  examples?: string;
  range: string;
  pct: number;
}

interface Props {
  title: string;
  legend: LegendItem[];
  /** Texto para el resumen de aria-label del contenedor (role="img"). */
  summary?: string;
  /** Plantilla del title="" de cada barra; recibe {pct} y {month}. */
  barTitle?: (pct: number, month: number) => string;
}

const { title, legend, summary, barTitle } = Astro.props;

// Serie de supervivencia hardcodeada (n=306). serie_pct[i] = % de la serie
// que seguía activa en el mes i — el índice 0 es el mes 0 (100%).
const seriePct = [
  100, 51, 41.5, 36.9, 33.3, 29.4, 27.8, 26.1, 24.5, 21.9, 20.3, 19.6, 19, 17.6, 17.3, 14.7, 14.1, 13.4, 12.4, 12.4,
  12.4, 12.4, 12.4, 12.4, 12.4, 11.8, 10.8, 10.5, 9.5, 8.8, 8.2, 7.5, 7.2, 6.9, 6.9, 6.5, 6.2, 6.2, 5.9, 5.2, 5.2, 4.9,
  4.9, 4.6, 4.6, 4.6, 4.2, 3.9, 3.6, 3.6, 3.6, 3.6, 3.3, 2.9, 2.9, 2.9, 2.9, 2.9, 2.9, 2.6, 2.6, 2.6, 2.6, 2.6, 2.3,
  2.3, 2.3, 2.3, 2.3, 2.3, 2.3, 2.3, 2.3, 2.3, 2, 2, 2, 1.3, 1.3, 1, 1, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7,
  0.7, 0.3, 0.3, 0.3, 0.3, 0.3, 0.3, 0,
];

// Fronteras de tramo (en meses): <=2, 3–10, 11–18, >18.
function zoneOf(month: number): 1 | 2 | 3 | 4 {
  if (month <= 2) return 1;
  if (month <= 10) return 2;
  if (month <= 18) return 3;
  return 4;
}

const defaultBarTitle = (pct: number, month: number) => `${pct}% de los procesos seguían al mes ${month}`;
const titleFor = barTitle ?? defaultBarTitle;

const bars = seriePct.map((pct, i) => {
  const month = i;
  return { pct, month, zone: zoneOf(month), title: titleFor(pct, month) };
});

const defaultSummary = `Curva de permanencia de ${legend.length} tramos sobre ${bars.length - 1} meses de seguimiento: ${legend
  .map((l) => `${l.name}, ${l.range}, ${l.pct}%`)
  .join('; ')}.`;
---

<div class="perm-curve" data-reveal>
  {title && <p class="label-section label-section--plain perm-curve__title">{title}</p>}

  <div class="perm-curve__chart-wrap on-dark">
    <div class="perm-curve__chart" role="img" aria-label={summary ?? defaultSummary}>
      {bars.filter((b) => b.pct > 0).map((b) => (
        <i class:list={[`perm-curve__bar`, `perm-curve__bar--z${b.zone}`]} style={`height:${b.pct}%`} title={b.title}></i>
      ))}
    </div>

    <div class="perm-curve__legend">
      {legend.map((item, i) => (
        <div class="perm-curve__legend-item">
          <span class={`perm-curve__swatch perm-curve__swatch--z${i + 1}`} aria-hidden="true"></span>
          <p class="perm-curve__legend-name">{item.name}</p>
          {item.examples && <p class="perm-curve__legend-examples">{item.examples}</p>}
          <p class="perm-curve__legend-figures">
            <span class="perm-curve__legend-range">{item.range}</span>
            <span class="perm-curve__legend-pct">{item.pct}%</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .perm-curve {
    margin-top: clamp(36px, 5vw, 56px);
  }
  .perm-curve__title {
    margin: 0 0 18px;
  }

  /* Silueta de supervivencia: ~100 franjas finas, una por mes, sin espacio
     entre ellas. Desviación deliberada del "surface gap" de 2px del skill
     (pensado para pocas barras discretas): con 100 marcas de <1% de ancho
     cada una, un gap de 2px fragmentaría la silueta y le quitaría la lectura
     de curva continua — el propio patrón de referencia del sitio
     (practica-en-numeros.html) resuelve igual esta forma. La identidad de
     tramo la lleva el color + la leyenda siempre visible, no un borde. */
  /* Isla de fondo fijo: los 4 tonos de marca de las barras se pintan sobre
     var(--surface), no sobre el --page-grad viajero del fondo. Sin esto, el
     tramo 4 (wine/purple) puede fundirse con el morado del degradado en
     tema oscuro, y --sand cae bajo 3:1 sobre el fondo claro (WCAG 1.4.11). */
  .perm-curve__chart-wrap {
    background: var(--surface);
    border-radius: var(--r-panel);
    padding: var(--sp-5);
  }
  .perm-curve__chart {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: clamp(160px, 22vw, 230px);
    border-bottom: 2px solid color-mix(in srgb, var(--on-canvas) 40%, transparent);
  }
  .perm-curve__bar {
    flex: 1 1 0;
    display: block;
    min-height: 2px;
    border-radius: 1px 1px 0 0;
  }
  /* Rampa ordinal sobre la isla oscura (--surface de .on-dark, #2e2140). Los
     tonos de marca puros (--wine, --purple) caen a 1.9:1 y 1.4:1 sobre ese
     fondo — por debajo del piso de 3:1 de WCAG 1.4.11 para objetos gráficos
     con significado — así que los dos tramos profundos se aclaran con
     --cream. Medido: 6.97 / 5.01 / 4.17 / 4.99 contra la isla. */
  .perm-curve__bar--z1 { background: var(--sand); }
  .perm-curve__bar--z2 { background: var(--sand-d); }
  .perm-curve__bar--z3 { background: color-mix(in srgb, var(--wine) 60%, var(--cream) 40%); }
  .perm-curve__bar--z4 { background: color-mix(in srgb, var(--purple) 45%, var(--cream) 55%); }
  .perm-curve__bar:hover { filter: brightness(1.25); }

  .perm-curve__legend {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px 28px;
    margin-top: clamp(20px, 3vw, 32px);
  }
  .perm-curve__legend-item {
    padding: 4px 20px 4px 0;
  }
  @media (min-width: 821px) {
    .perm-curve__legend-item:not(:first-child) {
      padding-left: 20px;
      border-left: 1px solid color-mix(in srgb, var(--on-canvas) 22%, transparent);
    }
  }
  .perm-curve__swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    margin-bottom: 10px;
  }
  .perm-curve__swatch--z1 { background: var(--sand); }
  .perm-curve__swatch--z2 { background: var(--sand-d); }
  .perm-curve__swatch--z3 { background: color-mix(in srgb, var(--wine) 60%, var(--cream) 40%); }
  .perm-curve__swatch--z4 { background: color-mix(in srgb, var(--purple) 45%, var(--cream) 55%); }
  .perm-curve__legend-name {
    margin: 0 0 4px;
    font-family: var(--ff-body);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.35;
    color: var(--on-canvas);
  }
  .perm-curve__legend-examples {
    margin: 0 0 8px;
    font-family: var(--ff-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--on-canvas-soft);
  }
  .perm-curve__legend-figures {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .perm-curve__legend-range {
    font-family: var(--ff-body);
    font-weight: 600;
    font-size: 13px;
    color: var(--on-canvas-soft);
  }
  .perm-curve__legend-pct {
    font-family: var(--ff-head);
    font-weight: 700;
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1;
    color: var(--accent-canvas);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 820px) and (min-width: 561px) {
    .perm-curve__legend { grid-template-columns: repeat(2, 1fr); }
    .perm-curve__legend-item { padding: 4px 20px 4px 0; border-left: none; }
    .perm-curve__legend-item:not(:nth-child(2n+1)) {
      padding-left: 20px;
      border-left: 1px solid color-mix(in srgb, var(--on-canvas) 22%, transparent);
    }
  }

  @media (max-width: 560px) {
    .perm-curve__legend { grid-template-columns: 1fr; gap: 20px; }
    .perm-curve__legend-item { padding: 4px 0; border-left: none; }
  }
</style>
