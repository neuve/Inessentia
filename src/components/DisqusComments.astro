---
interface Props {
  identifier: string;
  url: string;
  language?: string;
}

const { identifier, url, language = 'es' } = Astro.props;
---

<!-- Sin wrapper propio: BlogPost.astro ya aporta la sección (padding) y el
     .container--read (tope de ancho). Antes este componente metía su propio
     <section class="section"> + .container--blog (820px) DENTRO del
     .container--read (760px) del layout, lo que sumaba un --gutter extra de
     padding lateral por cada lado sin ganar nada (760 < 820, el tope ancho
     nunca llegaba a mandar). -->
<div id="disqus_thread"></div>

<script is:inline define:vars={{ identifier, url, language }}>
  var disqus_config = function () {
    this.page.url = url;
    this.page.identifier = identifier;
    this.language = language;
  };
  (function() {
    var d = document, s = d.createElement('script');
    s.src = 'https://inessentia.disqus.com/embed.js';
    s.setAttribute('data-timestamp', +new Date());
    (d.head || d.body).appendChild(s);
  })();
</script>
<noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
