---
// Standard page header (v1.5) — one component, two layouts chosen by
// whether a `photo` is passed:
//   • photo present → split editorial (A): copy left, portrait right.
//   • no photo      → monolith (B): full-bleed statement + floating stat
//                      ribbon card.
// @deprecated `split` and `monolith` variants are no longer used by any
// page (all pages use `panel` or `cinema`). Not removed yet — kept for
// backward compatibility until confirmed safe to delete.
// Always carries the brand standard: purple→beige left-to-right gradient
// (never vertical), white text, and (for split) a stat block or (for
// monolith) a floating white stat ribbon overlapping the next section.
// The language toggle is NOT duplicated here — Navbar.astro already
// renders a working floating `.lang-toggle` button sitewide.
//
// Body copy (lead paragraph(s), possibly with inline markup) goes in the
// default slot so pages keep their exact real content — this component
// never invents or paraphrases copy.

export interface Stat {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  /** Small caps meta line under the lead paragraph, e.g. "Presencial CDMX, Col. Nápoles · Online". */
  meta?: string;
  photo?: string;
  photoAlt?: string;
  /** Cinema only: variante recortada en apaisado (ver public/uploads/*-hero-cinema.*)
   * servida solo desde --bp-md (821px) vía <picture>, para que el retrato quede
   * encuadrado en el tercio derecho también en el eje horizontal. `photo` (el
   * original vertical) se mantiene como <img> de fallback para mobile, así
   * que sigue pasando por el pipeline de Img.astro/image-manifest.json sin
   * cambios. */
  photoDesktop?: string;
  /** Brand icon shown in a translucent circle above the eyebrow (monolith heros only). */
  icon?: string;
  /** Rendered height of the icon inside the circle, e.g. "132px". */
  iconSize?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  stats?: Stat[];
  variant?: 'auto' | 'split' | 'monolith' | 'panel' | 'cinema';
  /** Split only: `object-position` for the portrait inside its 4:5 box, to
   * fine-tune the vertical crop (e.g. `center 30%` on the home hero to drop
   * the wall clock while keeping air above the head). Defaults to the shared
   * framing used across the other pages. */
  photoPosition?: string;
  /** Split only: overrides the portrait box's `aspect-ratio` (default `4 / 5`), e.g. `1 / 1`. */
  photoAspect?: string;
  /** Panel only: larger card (individual page) — 52px title, 960px copy max-width. */
  panelLarge?: boolean;
  /** Cinema only: shrink the H1 clamp for longer titles (e.g. Sobre mí), so a
   * long headline doesn't wrap past 3 lines over the portrait's face. */
  titleCompact?: boolean;
}

import Img from './Img.astro';

const {
  eyebrow,
  title,
  meta,
  photo,
  photoAlt = '',
  photoDesktop,
  icon,
  iconSize = '120px',
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  stats = [],
  variant = 'auto',
  photoPosition,
  photoAspect,
  panelLarge = false,
  titleCompact = false,
} = Astro.props;

const mode = variant === 'auto' ? (photo ? 'split' : 'monolith') : variant;
---

{mode === 'split' ? (
  <section class="site-header site-header--split zone-dark">
    <div class="site-header__mandala" aria-hidden="true" data-parallax="0.06" data-parallax-max="50"></div>
    <div class="site-header__grid">
      <div data-reveal>
        {eyebrow && <p class="site-header__eyebrow">{eyebrow}</p>}
        <h1 class="site-header__title">{title}</h1>
        <div class="site-header__lead"><slot /></div>
        {meta && <h4 class="site-header__meta">{meta}</h4>}
        {(ctaHref || secondaryHref) && (
          <div class="site-header__actions">
            {ctaHref && <a href={ctaHref} target="_blank" rel="noopener" class="btn btn--gold">{ctaLabel}<span class="btn__dot"></span></a>}
            {secondaryHref && <a href={secondaryHref} class="site-header__link">{secondaryLabel}</a>}
          </div>
        )}
        {stats.length > 0 && (
          <div class="site-header__stats">
            {stats.map((s) => (
              <div class="site-header__stat">
                <b>{s.value}</b>
                <span set:html={s.label} />
              </div>
            ))}
          </div>
        )}
      </div>
      <div class="site-header__photo" data-reveal style={`${photoPosition ? `--photo-pos:${photoPosition};` : ''}${photoAspect ? `--photo-aspect:${photoAspect};` : ''}`}>
        {photo && <Img src={photo} alt={photoAlt} sizes="(max-width:900px) 100vw, 50vw" fetchpriority="high" loading="eager" data-parallax="0.10" data-parallax-max="32" />}
      </div>
    </div>
  </section>
) : mode === 'cinema' ? (
  <section class="site-header site-header--cinema zone-dark">
    <div class="site-header__cinema-photo" style={photoPosition ? `--photo-pos:${photoPosition};` : ''}>
      {/* minWidth=768: en mobile (412 CSS px × DSF 1.75 ≈ 722px físicos) el
          candidato ideal es el de 768w; 960 lo pasaba de largo y desperdiciaba
          ~21 KiB. sizes="100vw" es incondicional (no depende de un breakpoint
          por resolver), así que no hay ventana de "primera estimación" en la
          que el navegador pueda adivinar mal antes del layout: el riesgo de
          parpateo que documenta minWidth en Img.astro no aplica aquí. */}
      {photo && (
        photoDesktop ? (
          <picture>
            <source media="(min-width: 821px)" srcset={photoDesktop} />
            <Img src={photo} alt={photoAlt} sizes="100vw" minWidth={768} fetchpriority="high" loading="eager" />
          </picture>
        ) : (
          <Img src={photo} alt={photoAlt} sizes="100vw" minWidth={768} fetchpriority="high" loading="eager" />
        )
      )}
      <div class="site-header__cinema-veil" aria-hidden="true"></div>
    </div>
    <div class="site-header__cinema-inner" data-reveal>
      {/* Intro arriba: rótulo, titular y entradilla juntos, como en el hero
          de recursos. El velo diagonal despeja el lado del retrato. */}
      <div class="site-header__cinema-intro">
        {eyebrow && <p class="site-header__eyebrow">{eyebrow}</p>}
        <h1 class={`site-header__title site-header__title--cinema${titleCompact ? ' site-header__title--cinema-compact' : ''}`}>{title}</h1>
        <div class="site-header__lead site-header__lead--cinema"><slot /></div>
        {meta && <h4 class="site-header__meta">{meta}</h4>}
      </div>
      {(ctaHref || secondaryHref) && (
        <div class="site-header__cinema-band">
          <div class="site-header__cinema-rule" aria-hidden="true"></div>
          <div class="site-header__actions">
            {ctaHref && <a href={ctaHref} target="_blank" rel="noopener" class="btn btn--gold">{ctaLabel}<span class="btn__dot"></span></a>}
            {secondaryHref && <a href={secondaryHref} class="site-header__link">{secondaryLabel}</a>}
          </div>
        </div>
      )}
    </div>
  </section>
) : mode === 'panel' ? (
  <section class="site-header site-header--panel zone-dark">
    <div class="site-header__panel-rail" aria-hidden="true"></div>
    <div class="site-header__panel-inner" data-reveal>
      <div class={`site-header__panel-copy${panelLarge ? ' site-header__panel-copy--lg' : ''}`}>
        {eyebrow && <p class="site-header__eyebrow site-header__eyebrow--panel">{eyebrow}</p>}
        <h1 class={`site-header__title site-header__title--panel${panelLarge ? ' site-header__title--panel-lg' : ''}`}>{title}</h1>
        <div class={`site-header__lead site-header__lead--panel${panelLarge ? ' site-header__lead--panel-lg' : ''}`}><slot /></div>
        {meta && <h4 class="site-header__meta site-header__meta--panel">{meta}</h4>}
        {(ctaHref || secondaryHref) && (
          <div class="site-header__actions">
            {ctaHref && <a href={ctaHref} target="_blank" rel="noopener" class="btn btn--gold">{ctaLabel}<span class="btn__dot"></span></a>}
            {secondaryHref && <a href={secondaryHref} class="site-header__link site-header__link--panel">{secondaryLabel}</a>}
          </div>
        )}
      </div>
      {icon && (
        <div class="site-header__panel-icon">
          <div class="site-header__panel-icon-circle">
            <Img src={icon} alt="" sizes="160px" style={`height:${iconSize};width:auto;display:block;`} />
          </div>
        </div>
      )}
    </div>
  </section>
) : (
  <>
    <section class="site-header site-header--monolith zone-dark">
      <div class="site-header__mandala site-header__mandala--a" aria-hidden="true" data-parallax="0.06" data-parallax-max="50"></div>
      <div class="site-header__monolith-inner" data-reveal>
        {icon && (
          <div class="site-header__icon">
            <Img src={icon} alt="" sizes="160px" style={`height:${iconSize};width:auto;display:block;`} />
          </div>
        )}
        {eyebrow && <p class="site-header__eyebrow">{eyebrow}</p>}
        <h1 class="site-header__title site-header__title--mono">{title}</h1>
        <div class="site-header__lead site-header__lead--mono"><slot /></div>
        {(ctaHref || secondaryHref) && (
          <div class="site-header__actions">
            {ctaHref && <a href={ctaHref} target="_blank" rel="noopener" class="btn btn--gold">{ctaLabel}<span class="btn__dot"></span></a>}
            {secondaryHref && <a href={secondaryHref} class="site-header__link">{secondaryLabel}</a>}
          </div>
        )}
      </div>
    </section>
    {stats.length > 0 && (
      <div class="site-header__ribbon-wrap on-light">
        <div class="site-header__ribbon">
          {stats.map((s, i) => (
            <>
              {i > 0 && <div class="site-header__ribbon-div" aria-hidden="true"></div>}
              <div class="site-header__ribbon-item">
                <b>{s.value}</b>
                <span set:html={s.label} />
              </div>
            </>
          ))}
        </div>
      </div>
    )}
  </>
)}

<style>
  .site-header {
    /* Contrato "noche → amanecer": el hero nunca pinta su propio fondo —
       vive sobre el lienzo continuo del body (--page-grad) y declara
       zone-dark en el marcado para resolver el color de texto correcto. */
    position: relative;
    overflow: hidden;
    background: transparent;
  }
  .site-header__mandala {
    position: absolute;
    pointer-events: none;
    background: repeating-conic-gradient(#fff 0deg .55deg, transparent .55deg 7deg);
    -webkit-mask: radial-gradient(circle, transparent 29%, #000 30%, #000 49%, transparent 50%);
    mask: radial-gradient(circle, transparent 29%, #000 30%, #000 49%, transparent 50%);
  }

  /* ---------- Split (A) ---------- */
  .site-header--split { min-height: 88vh; display: flex; align-items: center; }
  .site-header--split .site-header__mandala { top: -140px; right: -120px; width: 560px; height: 560px; opacity: .14; }
  .site-header__grid {
    position: relative; max-width: var(--container-w); margin: 0 auto; width: 100%;
    padding: 130px 32px 90px;
    display: grid; grid-template-columns: minmax(0,1.12fr) minmax(0,.88fr);
    gap: clamp(36px, 4vw, 72px); align-items: center;
  }
  @media (max-width: 860px) { .site-header__grid { grid-template-columns: 1fr; } }
  /* Portrait: fixed 4:5 box. `--photo-pos` (from the `photoPosition` prop)
     fine-tunes the vertical crop per page; the default replicates the prior
     framing (image at 120% height pulled up 10% ≈ object-position center 8%).
     Sin recorte duro: se funde al lienzo por abajo y por los lados con una
     máscara radial en vez de un borde/sombra que lo delate como bloque. */
  .site-header__photo {
    position: relative; overflow: visible; aspect-ratio: var(--photo-aspect, 4 / 5);
    width: 100%; max-width: var(--photo-max-w, none); margin-left: auto;
    -webkit-mask-image: radial-gradient(ellipse 92% 88% at 50% 42%, #000 60%, transparent 100%);
    mask-image: radial-gradient(ellipse 92% 88% at 50% 42%, #000 60%, transparent 100%);
  }
  .site-header__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--photo-pos, center 8%); display: block; border-radius: 18px; }

  /* ---------- Cinema (A — home + sobre mí, foto a sangre completa) ---------- */
  /* Alto contenido en vez de 90vh, como el hero de recursos. El + var(--nav-h)
     compensa el margin-top negativo que global.css aplica a .site-header para
     que el hero se meta bajo la barra transparente. */
  .site-header--cinema { height: calc(clamp(540px, 64vw, 600px) + var(--nav-h)); display: flex; align-items: stretch; }
  /* El contenedor foto+velo se funde hacia abajo en el lienzo transparente
     de la sección (en vez de cortar en seco contra la siguiente sección). */
  .site-header__cinema-photo {
    position: absolute; inset: 0;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 80%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 80%, transparent 100%);
  }
  .site-header__cinema-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--photo-pos, center 30%); display: block; }
  .site-header__cinema-veil {
    /* Velo DIAGONAL (118°): opaco donde va el texto y despejado donde está el
       sujeto del retrato. El vertical anterior pasaba por encima de la cara. */
    position: absolute; inset: 0;
    background: linear-gradient(118deg, rgba(var(--veil-purple),.95) 0%, rgba(var(--veil-purple),.82) 38%, rgba(var(--veil-purple),.34) 72%, rgba(var(--veil-purple),.12) 100%);
  }
  .site-header__cinema-inner {
    /* Tope propio, más angosto que --container-w: este texto vive encima de un
       retrato con foco en la cara. El padding lateral (40px) coincide con el
       del nav para que el borde derecho alinee con la hamburguesa. */
    position: relative; z-index: 2; width: 100%; max-width: clamp(1200px, 82vw, 1440px); margin: 0 auto;
    padding: calc(clamp(32px, 5vw, 46px) + var(--nav-h)) 40px 40px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
  }
  .site-header__cinema-intro { max-width: 52ch; }
  .site-header__cinema-band { width: 100%; }
  .site-header__cinema-rule { height: 1px; background: rgba(255,255,255,.25); margin-bottom: 22px; }
  .site-header--cinema .site-header__title--cinema { font-size: var(--fs-display); margin-bottom: 20px; }
  .site-header--cinema .site-header__title--cinema-compact { font-size: clamp(32px, 3.8vw, 54px); }
  .site-header--cinema .site-header__lead--cinema { max-width: 50ch; margin: 0; color: var(--on-canvas); }
  .site-header--cinema .site-header__actions { margin-bottom: 0; }
  .site-header--cinema .site-header__eyebrow,
  .site-header--cinema .site-header__title--cinema { text-shadow: 0 1px 22px rgba(38,20,60,.5); }
  @media (max-width: 820px) {
    /* En móvil la composición se invierte respecto al desktop: el retrato manda
       ARRIBA, despejado, y TODO el texto (rótulo, titular, entradilla y banda de
       acciones) baja al tercio inferior. En pantalla angosta el texto no cabe
       junto a la cara sin montarse encima; con esta inversión ninguno estorba al
       otro. Por eso el velo también se invierte: casi transparente arriba para
       que se vea la cara, opaco abajo para que el texto sea legible. Una
       diagonal aquí no serviría: el sujeto queda centrado, no a un lado. */
    .site-header--cinema { height: calc(clamp(560px, 108vw, 660px) + var(--nav-h)); }
    .site-header__cinema-veil { background: linear-gradient(180deg, rgba(var(--veil-purple),.30) 0%, rgba(var(--veil-purple),.14) 26%, rgba(var(--veil-purple),.52) 56%, rgba(var(--veil-purple),.93) 100%); }
    .site-header__cinema-inner { padding: calc(28px + var(--nav-h)) 24px 32px; gap: 20px; justify-content: flex-end; }
    /* Encuadre propio de móvil: --photo-pos (que fijan las páginas) está
       calibrado para el recorte apaisado del desktop y aquí deja la cara
       demasiado alta. Las páginas pueden afinarlo con --photo-pos-mobile. */
    .site-header__cinema-photo img { object-position: var(--photo-pos-mobile, center 18%); }
    .site-header__cinema-intro { max-width: 100%; }
    .site-header--cinema .site-header__title--cinema { font-size: clamp(34px, 9vw, 46px); margin-bottom: 16px; }
    .site-header--cinema .site-header__title--cinema-compact { font-size: clamp(26px, 7vw, 36px); }
  }

  /* ---------- Panel (C) ---------- */
  .site-header--panel { background: transparent; min-height: 62vh; display: flex; align-items: center; padding: 150px 0 80px; }
  .site-header__panel-rail { position: absolute; inset: 0 auto 0 0; width: 6px; background: var(--grad-rail); }
  .site-header__panel-inner {
    /* Grid en vez de flex space-between: el ícono vive en su propia columna
       (no pegado al borde derecho) y se centra dentro de ella. */
    position: relative; max-width: var(--container-w); margin: 0 auto; width: 100%; padding: 0 40px 0 48px;
    display: grid; grid-template-columns: minmax(0,1fr) minmax(0,.5fr); align-items: center; gap: clamp(24px, 4vw, 56px);
  }
  .site-header__panel-copy { max-width: 66%; }
  .site-header__panel-copy--lg { max-width: 960px; }
  .site-header__panel-icon { width: 100%; display: flex; align-items: center; justify-content: center; }
  /* Disco detrás del ícono de modalidad: lo asienta en su columna en vez de
     flotar suelto sobre el fondo. Consume --grad-disc, el mismo token que
     usan las tarjetas de la home (.icon-disc), para mantener la identidad. */
  .site-header__panel-icon-circle {
    display: flex; align-items: center; justify-content: center;
    width: clamp(240px, 24vw, 300px); aspect-ratio: 1; border-radius: 50%;
    background: var(--grad-disc);
    box-shadow: inset 0 0 0 1px rgba(70,39,110,.05);
  }
  /* Panel text colours must beat the shared white/sand rules below, which
     have equal specificity but come later in source order. Prefix with the
     block class to win regardless of order. */
  .site-header--panel .site-header__eyebrow--panel { color: var(--accent-canvas); }
  .site-header--panel .site-header__eyebrow--panel::before { background: var(--accent-canvas); }
  /* Nota: 34px / clamp(34px,4.6vw,52px) NO se sustituyen por --fs-h2
     (clamp(30px,4.4vw,50px)) porque no son el mismo valor — hacerlo
     cambiaría el tamaño renderizado en desktop. Se dejan como literales. */
  .site-header--panel .site-header__title--panel { color: var(--heading-canvas); font-size: 34px; line-height: 1.18; }
  .site-header--panel .site-header__title--panel-lg { font-size: clamp(34px, 4.6vw, 52px); line-height: 1.14; }
  .site-header--panel .site-header__lead--panel { color: var(--on-canvas-soft); font-family: var(--ff-body); font-weight: 500; font-size: 14px; max-width: 60ch; }
  .site-header--panel .site-header__lead--panel-lg { font-size: 16px; }
  .site-header__lead--panel :global(p) { margin: 0 0 10px; }
  .site-header__lead--panel :global(p:last-child) { margin-bottom: 0; }
  .site-header--panel .site-header__meta--panel { color: var(--on-canvas-faint); }
  .site-header--panel .site-header__link--panel { color: var(--accent-canvas); text-decoration: none; border-bottom: none; }
  .site-header--panel .site-header__link--panel:hover { color: var(--accent-canvas); text-decoration: none; border-bottom: none; opacity: .75; }
  @media (max-width: 860px) {
    .site-header__panel-inner { grid-template-columns: 1fr; padding-left: 32px; }
    .site-header__panel-copy { max-width: 100%; grid-row: 2; }
    .site-header__panel-icon { grid-row: 1; }
  }

  /* ---------- Monolith (B) ---------- */
  .site-header--monolith { min-height: 66vh; display: flex; align-items: center; padding: 130px 0 96px; }
  .site-header--monolith .site-header__mandala--a { top: 50%; margin-top: -320px; left: 60%; width: 640px; height: 640px; opacity: .13; }
  .site-header__monolith-inner { position: relative; max-width: 780px; margin: 0 auto; padding: 0 32px; }
  .site-header__monolith-inner .site-header__lead { max-width: 56ch; }
  .site-header__icon {
    width: 172px; height: 172px; border-radius: 50%;
    background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2);
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
    display: flex; align-items: center; justify-content: center; margin: 0 0 26px;
  }
  @media (max-width: 520px) { .site-header__icon { width: 140px; height: 140px; } }

  /* ---------- Shared text ----------
     Regla de oro del contrato noche→amanecer: nada de #fff/rgba(255,255,255,…)
     fijos ni var(--wine)/(--sand)/(--purple) como color de texto — el hero
     depende de la zona (.zone-dark) para resolver --on-canvas/--heading-canvas/
     --accent-canvas correctamente en cualquier punto del lienzo y en ambos
     temas. */
  .site-header__eyebrow { margin: 0 0 18px; display: inline-flex; align-items: center; gap: 12px; font-weight: 700; font-size: 14px; letter-spacing: 0; text-transform: none; color: var(--accent-canvas); }
  .site-header__eyebrow::before { content: ""; width: 24px; height: 2px; flex: 0 0 auto; background: var(--accent-canvas); }
  /* Bitter tiene tildes que sobresalen; con menos de ~1.12 chocan con la línea de arriba. */
  .site-header__title { font-family: var(--ff-head); font-weight: 700; color: var(--heading-canvas); font-size: var(--fs-h1); line-height: 1.14; letter-spacing: -.015em; margin: 0 0 22px; text-wrap: balance; }
  /* Nota: clamp(40px,6vw,76px) NO se sustituye por --fs-display
     (clamp(40px,5.6vw,80px)) porque no son el mismo valor. Se deja literal. */
  .site-header__title--mono { font-size: clamp(40px, 6vw, 76px); line-height: 1.10; }
  .site-header__lead { font-size: clamp(16px, 1.3vw, 19px); line-height: 1.65; color: var(--on-canvas-soft); max-width: 48ch; margin: 0 0 32px; }
  .site-header__lead :global(p) { margin: 0 0 10px; }
  .site-header__lead :global(p:last-child) { margin-bottom: 0; }
  .site-header__meta { margin: 0 0 30px; font-weight: 600; font-size: 13px; letter-spacing: 0; text-transform: none; color: var(--on-canvas-faint); }
  /* Aire balanceado alrededor del pill: ~30px arriba (meta) y ~34px abajo (stats). */
  .site-header__actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin-bottom: 34px; }
  /* Tertiary CTA: quiet text link so it doesn't compete with the primary gold pill */
  .site-header__link { color: var(--on-canvas-faint); font-weight: 600; font-size: 14px; text-decoration: none; border-bottom: 1px solid transparent; padding-bottom: 1px; transition: color .2s, border-color .2s; }
  .site-header__link:hover { color: var(--on-canvas); border-bottom-color: currentColor; }

  /* ---------- Numeralia (split — grid de 3 columnas, sin divisores) ---------- */
  .site-header__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 150px)); gap: clamp(20px, 2.4vw, 34px); }
  .site-header__stat b { font-family: var(--ff-head); font-weight: 700; font-size: clamp(34px,4.4vw,42px); line-height: .9; color: var(--heading-canvas); display: block; }
  .site-header__stat span { font-size: 13px; line-height: 1.5; color: var(--on-canvas-soft); display: block; margin-top: 8px; }
  .site-header__stat span :global(strong) { color: var(--heading-canvas); font-weight: 700; }
  @media (max-width: 420px) {
    .site-header__stats { grid-template-columns: 1fr; gap: 18px; }
  }

  /* ---------- Stat ribbon (monolith, floating card) ---------- */
  .site-header__ribbon-wrap { position: relative; z-index: 6; max-width: 1000px; margin: -48px auto 0; padding: 0 32px; }
  .site-header__ribbon {
    background: #fff; border: 1px solid #ece6d8; border-radius: 20px;
    box-shadow: 0 26px 60px rgba(70,39,110,.16); padding: 28px 36px;
    display: flex; gap: 36px; flex-wrap: wrap; justify-content: space-around; text-align: center;
  }
  .site-header__ribbon-item b { font-family: var(--ff-head); font-weight: 700; font-size: 40px; color: var(--wine); display: block; line-height: .9; }
  .site-header__ribbon-item span { font-size: 14px; color: var(--text-muted); }
  .site-header__ribbon-div { width: 1px; background: #ece6d8; }
</style>

<script is:inline>
  (function () {
    // Contador animado de la numeralia (solo hero split, p. ej. el home).
    var nums = Array.prototype.slice.call(document.querySelectorAll('.site-header__stats b'));
    if (!nums.length) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    nums.forEach(function (el) {
      var target = parseInt((el.textContent || '').replace(/[^0-9]/g, ''), 10);
      if (isNaN(target)) return;
      el.setAttribute('data-final', String(target));
      if (!reduce) el.textContent = '0';
    });
    if (reduce || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        var el = e.target;
        var target = parseInt(el.getAttribute('data-final'), 10);
        var dur = 1400, start = null, done = false;
        function finish() { if (!done) { done = true; el.textContent = String(target); } }
        function step(ts) {
          if (done) return;
          if (start === null) start = ts;
          var p = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(eased * target));
          if (p < 1) requestAnimationFrame(step); else finish();
        }
        requestAnimationFrame(step);
        // Fallback: garantiza el valor final aunque rAF se pause (p. ej. tab en background).
        setTimeout(finish, dur + 300);
      });
    }, { threshold: 0.4 });
    nums.forEach(function (el) { io.observe(el); });
  })();
</script>
