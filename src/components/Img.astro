---
// <Img> — imagen responsiva servida desde public/uploads.
//
// Lee src/data/image-manifest.json (generado por tools/generate-responsive-images.mjs)
// y emite un <img> con srcset/sizes + width/height intrínsecos (CLS 0). El
// navegador baja el ancho que corresponde a su viewport × densidad, así que un
// mismo hueco ya no fuerza un archivo sobredimensionado en desktop o mobile.
//
// `src` SIEMPRE se resuelve contra `entry.src` (la copia hasheada por
// contenido del master) cuando hay entrada en el manifiesto — nunca se sirve
// la ruta cruda de public/uploads, que es la que puede quedar cacheada por un
// año en el CDN si se regenera el archivo bajo el mismo nombre.
//
// Mantiene la arquitectura de strings (`src="/uploads/…"`): no hay que importar
// assets ni tocar schema/OG. Si el src no está en el manifiesto (remoto, no
// procesado), cae a un <img> normal sin romper nada. Los svg/mp4/webm SÍ están
// en el manifiesto (hasheados) pero solo traen `.src`, sin srcset/width/height
// — ver la rama `hasSrcset` abajo: se sirven como <img> simple con la URL
// hasheada, igual que un src no encontrado, sin intentar construir un srcset
// que no existe.
import manifestJson from '../data/image-manifest.json';

interface Variant { w: number; url: string; }
interface Entry { width?: number; height?: number; srcset?: Variant[]; src?: string; }

interface Props {
  src: string;
  alt?: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Descarta candidatos del srcset por debajo de este ancho (px). Úsalo en
   * imágenes que SIEMPRE se muestran grandes (heros a sangre completa) para
   * que el navegador no tenga a mano una variante minúscula que a veces
   * elige como primera estimación antes de resolver el layout real —eso
   * produce un parpadeo visible de baja resolución en la primera pintura. */
  minWidth?: number;
  [key: string]: unknown;
}

const {
  src,
  alt = '',
  sizes = '100vw',
  class: className,
  loading = 'lazy',
  fetchpriority,
  minWidth,
  ...rest
} = Astro.props;

const manifest = manifestJson as Record<string, Entry>;
const entry = manifest[src];
// Src resuelto: hasheado si hay entrada en el manifiesto, crudo si no.
const resolvedSrc = entry?.src ?? src;
const hasSrcset = !!entry?.srcset?.length;
const variants = hasSrcset && minWidth
  ? entry!.srcset!.filter((v) => v.w >= minWidth || v.w === entry!.srcset![entry!.srcset!.length - 1].w)
  : entry?.srcset;
const srcset = variants ? variants.map((v) => `${v.url} ${v.w}w`).join(', ') : undefined;
---

{hasSrcset ? (
  <img
    src={resolvedSrc}
    srcset={srcset}
    sizes={sizes}
    width={entry!.width}
    height={entry!.height}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    {...rest}
  />
) : (
  <img
    src={resolvedSrc}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    {...rest}
  />
)}
