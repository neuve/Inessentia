---
// Banda de números: eyebrow + grid de cifras animadas (conteo al entrar en
// viewport) + cita de remate + nota al pie. Vive sobre zone-dark.
interface Stat {
  value: number;
  count?: number; // valor final a animar; si se omite, usa `value`
  suffix?: string; // texto fijo tras la cifra animada (no se anima)
  label: string;
}

interface ScaleStep {
  name: string;
  time: string;
  evidence?: string;
}

interface Props {
  eyebrow: string;
  lede?: string;
  stats: Stat[];
  scaleTitle?: string;
  scaleSteps?: ScaleStep[];
  scaleNote?: string;
  subline?: string;
  quote: string;
  quoteTag?: string;
  footnote?: string;
}

const { eyebrow, lede, stats, scaleTitle, scaleSteps, scaleNote, subline, quote, quoteTag, footnote } = Astro.props;

function formatThousands(n: number): string {
  return n.toLocaleString('en-US');
}
---

<section class="section zone-dark stats-band">
  <div class="container">
    <p data-reveal class="label-section">{eyebrow}</p>
    {lede && <p class="stats-band__lede" data-reveal>{lede}</p>}

    <div class="stats-band__grid" style={`--cols:${stats.length}`}>
      {stats.map((s) => {
        const target = s.count ?? s.value;
        return (
          <div class="stats-band__cell" data-reveal>
            <p class="stats-band__figure">
              <span class="stats-band__count" data-count-to={target}>{formatThousands(target)}</span>{s.suffix ?? ''}
            </p>
            <p class="stats-band__label">{s.label}</p>
          </div>
        );
      })}
    </div>

    {scaleSteps && scaleSteps.length > 0 && (
      <div class="stats-band__scale" data-reveal>
        {scaleTitle && <p class="label-section label-section--plain stats-band__scale-title">{scaleTitle}</p>}
        <div class="stats-band__scale-grid">
          {scaleSteps.map((step) => (
            <div class="stats-band__scale-step">
              <p class="stats-band__scale-name">{step.name}</p>
              <p class="stats-band__scale-time">{step.time}</p>
              {step.evidence && <p class="stats-band__scale-evidence">{step.evidence}</p>}
            </div>
          ))}
        </div>
        {scaleNote && <p class="stats-band__scale-note">{scaleNote}</p>}
      </div>
    )}

    {subline && <p class="stats-band__subline" data-reveal>{subline}</p>}

    <div class="stats-band__quote-wrap" data-reveal>
      <p class="stats-band__quote">{quote}</p>
      {quoteTag && <p class="stats-band__quote-tag">{quoteTag}</p>}
    </div>

    {footnote && <p class="stats-band__footnote" data-reveal>{footnote}</p>}
  </div>
</section>

<style>
  .stats-band__lede {
    margin: 14px 0 0;
    font-family: var(--ff-body);
    font-weight: 600;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--on-canvas);
  }
  .stats-band__lede + .stats-band__grid {
    margin-top: clamp(28px, 4vw, 40px);
  }
  .stats-band__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    row-gap: 24px;
  }
  .stats-band__cell {
    padding: 4px 28px 4px 0;
    border-left: none;
  }
  @media (min-width: 821px) {
    .stats-band__cell:not(:first-child),
    .stats-band__scale-step:not(:first-child) {
      padding-left: 28px;
      border-left: 1px solid color-mix(in srgb, var(--on-canvas) 22%, transparent);
    }
  }

  .stats-band__scale {
    margin-top: clamp(36px, 5vw, 56px);
  }
  .stats-band__scale-title {
    margin: 0 0 18px;
  }
  .stats-band__scale-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: 20px;
  }
  .stats-band__scale-step {
    padding: 4px 28px 4px 0;
  }
  .stats-band__scale-name {
    margin: 0 0 6px;
    font-family: var(--ff-body);
    font-weight: 700;
    font-size: 14px;
    color: var(--on-canvas);
  }
  .stats-band__scale-time {
    margin: 0;
    font-family: var(--ff-head);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.1;
    color: var(--accent-canvas);
  }
  .stats-band__scale-evidence {
    margin: 6px 0 0;
    font-family: var(--ff-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--on-canvas-soft);
  }
  .stats-band__scale-note {
    margin: 18px 0 0;
    font-family: var(--ff-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-canvas-soft);
    max-width: 60ch;
  }
  .stats-band__figure {
    margin: 0 0 8px;
    font-family: var(--ff-head);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    color: var(--accent-canvas);
    font-variant-numeric: tabular-nums;
  }
  .stats-band__label {
    margin: 0;
    font-family: var(--ff-body);
    font-size: 14px;
    line-height: 1.4;
    color: var(--on-canvas-soft);
  }
  .stats-band__subline {
    margin: 28px 0 0;
    font-family: var(--ff-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-canvas-soft);
  }
  .stats-band__quote-wrap {
    margin-top: clamp(36px, 5vw, 56px);
    max-width: 62ch;
  }
  .stats-band__quote {
    margin: 0;
    font-family: var(--ff-head);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(18px, 2vw, 20px);
    line-height: 1.5;
    color: var(--heading-canvas);
  }
  .stats-band__quote-tag {
    margin: 6px 0 0;
    font-family: var(--ff-head);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(18px, 2vw, 20px);
    line-height: 1.5;
    color: var(--heading-canvas);
  }
  .stats-band__footnote {
    margin: 20px 0 0;
    font-family: var(--ff-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--on-canvas-faint);
  }

  @media (max-width: 820px) and (min-width: 561px) {
    .stats-band__grid { grid-template-columns: repeat(2, 1fr); }
    .stats-band__scale-step:not(:first-child) {
      padding-left: 28px;
      border-left: 1px solid color-mix(in srgb, var(--on-canvas) 22%, transparent);
    }
    .stats-band__cell {
      padding: 4px 28px 4px 0;
      border-left: none;
    }
    .stats-band__cell:not(:nth-child(2n+1)) {
      padding-left: 28px;
      border-left: 1px solid color-mix(in srgb, var(--on-canvas) 22%, transparent);
    }
  }

  @media (max-width: 560px) {
    .stats-band__grid { grid-template-columns: 1fr; row-gap: 24px; }
    .stats-band__scale-grid { grid-template-columns: 1fr; }
    .stats-band__cell,
    .stats-band__scale-step {
      padding: 4px 0;
      border-left: none;
    }
  }
</style>

<script is:inline>
(function () {
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function formatThousands(n) {
    return Math.round(n).toLocaleString('en-US');
  }

  function animateCount(el) {
    var target = parseFloat(el.getAttribute('data-count-to'));
    if (!isFinite(target)) return;
    if (reduceMotion) {
      el.textContent = formatThousands(target);
      return;
    }
    var duration = 1200;
    var start = null;
    function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
    function step(ts) {
      if (start === null) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var eased = easeOutCubic(progress);
      el.textContent = formatThousands(target * eased);
      if (progress < 1) {
        window.requestAnimationFrame(step);
      } else {
        el.textContent = formatThousands(target);
      }
    }
    window.requestAnimationFrame(step);
  }

  function init() {
    var bands = document.querySelectorAll('.stats-band');
    if (!bands.length) return;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      document.querySelectorAll('.stats-band__count').forEach(function (el) {
        var target = parseFloat(el.getAttribute('data-count-to'));
        if (isFinite(target)) el.textContent = formatThousands(target);
      });
      return;
    }

    bands.forEach(function (band) {
      var counts = band.querySelectorAll('.stats-band__count');
      if (!counts.length) return;
      var animated = false;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !animated) {
            animated = true;
            counts.forEach(function (el) {
              el.textContent = '0';
              animateCount(el);
            });
            io.unobserve(band);
          }
        });
      }, { threshold: 0.3 });
      io.observe(band);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
