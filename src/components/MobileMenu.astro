---
import { t, menuColumns, type Locale } from '../i18n/utils';
import { resolveAsset } from '../lib/resolve-asset';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const i = t(locale);
// Misma fuente de verdad que el overlay editorial de desktop (menuColumns):
// así los ítems y etiquetas del menú móvil y del de escritorio son idénticos.
const [col1, col2] = menuColumns(locale, Astro.url.pathname);
const links = [...col1, ...col2];
---

<div id="mob-menu">
  <button id="mob-close" aria-label={i.nav.closeMenu}>×</button>
  {links.map(link => (
    link.cta
      ? <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined} class="mob-cta">{link.label}</a>
      : <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
  ))}
  <div class="mob-social">
    <a href="https://www.instagram.com/neuve" target="_blank" rel="noopener" aria-label="Instagram"><img src={resolveAsset('/uploads/instagram-icon.svg')} alt="" width="20" height="20" /></a>
    <a href="https://www.facebook.com/neuve0/" target="_blank" rel="noopener" aria-label="Facebook"><img src={resolveAsset('/uploads/facebook-icon.png')} alt="" width="20" height="20" /></a>
    <a href="https://wa.me/patriciomx" target="_blank" rel="noopener" aria-label="WhatsApp"><img src={resolveAsset('/uploads/whatsapp-icon.svg')} alt="" width="20" height="20" /></a>
    <a href="https://www.linkedin.com/in/patricioruiz/" target="_blank" rel="noopener" aria-label="LinkedIn"><img src={resolveAsset('/uploads/linkedin-icon.png')} alt="" width="20" height="20" /></a>
    <button type="button" data-theme-toggle aria-label="Cambiar tema" title="Cambiar tema">◐</button>
  </div>
</div>
