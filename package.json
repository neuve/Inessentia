{
  "name": "inessentia-astro",
  "type": "module",
  "version": "1.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "images": "node tools/generate-responsive-images.mjs",
    "dev": "node tools/generate-responsive-images.mjs && astro dev --port \"${PORT:-4321}\"",
    "build": "node tools/generate-responsive-images.mjs && astro build && node tools/check-immutable-urls.mjs && node tools/check-terceros.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "i18n:diff": "node tools/i18n-diff.mjs",
    "data:diez-anos": "node tools/sync-diez-anos.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.3",
    "sharp": "^0.34.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
